// Users service schema — users_db (feature 006, roadmap 2.2/2.7).
// DB-per-service (ADR 0029): targets ONLY users_db via the service's own DATABASE_URL +
// role. Per-service generated client path (research R1). Owns the Player entity
// ("Player-lite", ADR 0032 §0.1) + the brand-union edge (soft brand_id, no cross-service FK).
// Model surface reviewed in specs/006-contracts-data-model/data-model.md (Users section).

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// A staff member's operational profile — distinct from the Auth `User` identity, linked by a
/// soft `auth_user_id` (no cross-service FK). Custom attributes are an extensible JSON blob (R5).
model Operator {
  id                String   @id @default(uuid())
  account_id        String
  auth_user_id      String // soft ref to auth.User.id (resolved via gRPC, never joined)
  display_name      String?
  active            Boolean  @default(true)
  custom_attributes Json?
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  @@index([account_id])
}

/// The core customer entity, keyed by `player_id`, unified across 1..N brands (ADR 0032 §0.1).
/// Player-lite: identity + our own fields + an OPAQUE GR8-cache seam. vip/segment are columns
/// (indexed) because they drive routing filters (Principle VII); free classification lives in
/// custom_attributes (R5). GR8's typed projection is deferred to 7.4 — we don't own its schema.
/// ═══════════════════════════════════════════════════════════════════════════════════════════════
/// ⚠️ A PLAYER IS IDENTIFIED BY (account_id, brand_id, player_id) — feature 020, ADR 0038 §3.
///
/// `player_id` came from GR8 and is unique only WITHIN a brand. The same value under brand A and
/// brand B is routinely TWO DIFFERENT HUMAN BEINGS. Until 2026-07-29 this model used it as the whole
/// primary key, so those two people collapsed into ONE ROW — one card, one VIP flag, one set of AM
/// notes — and the conversation feed then served one customer another's messages.
///
/// GR8's own contract corroborates it: `POST /players/find` answers with `brand` alongside
/// `playerId`, and uses email/phone as the person-level identifier. That document has been in this
/// repository since 2026-07-21 — four days AFTER ADR 0032 declared `player_id` globally unique.
///
/// `account_id` leads the key so the isolation predicate the Prisma extension injects stays
/// index-aligned, AND so two future licensees can both hold player `12345` (the same mistake, one
/// layer up, fixed in the same change).
///
/// Cross-brand linking of two records into one HUMAN is a separate, evidence-based act — see
/// `ContactMatch` / `Person` below. It is never a consequence of two platform ids being equal.
/// ═══════════════════════════════════════════════════════════════════════════════════════════════
model Player {
  player_id         String // domain key from GR8 — unique only WITHIN a brand
  brand_id          String // soft ref to brands.Brand.id (no cross-service FK)
  account_id        String
  vip               Boolean  @default(false)
  segment           String?
  // Our own AM-owned fields (replace the Excel portfolio — ADR 0032 §4):
  am_notes          String?
  preferences       Json?
  portfolio         Json? // portfolio scaffold; typed VIP fields land at 5.5
  custom_attributes Json?
  // Opaque GR8-cache seam (R4) — snapshot stored verbatim; NO GR8-typed columns. Populated by
  // the async Worker connector at 7.4. Defaults to stale so an unpopulated player reads "unknown".
  gr8_snapshot      Json?
  gr8_fetched_at    DateTime?
  gr8_stale         Boolean   @default(true)
  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt

  contact_matches ContactMatch[]
  person_links    PersonMember[]

  @@id([account_id, brand_id, player_id])
  @@index([account_id])
  @@index([account_id, vip])
  @@index([account_id, segment])
  /// Feature 018 (roadmap 5.1): the keyset page for ListPlayersByBrand. ONE index serving three jobs
  /// at once — the `account_id` predicate the isolation extension injects, the `(created_at, player_id)`
  /// sort, and the tie-break that keeps a record from being skipped when several share an instant.
  /// Feature 020 adds `brand_id` after the account: the brand list is now a direct predicate on this
  /// table (the edge it used to resolve through is gone), so the index must filter and sort in one pass.
  @@index([account_id, brand_id, created_at, player_id])
}

/// ⚠️ `PlayerBrand` was REMOVED by feature 020. With brand in the key, one row IS one brand's player,
/// so a many-to-many edge between a player and brands can no longer state anything true. Its one
/// legitimate job — "this human exists on several brands" — moved to `Person` below, where it is a
/// statement about a PERSON rather than a property of a row. Its `[brand_id, player_id]` index went
/// with it: it existed only to make the edge-then-parent join pageable, and that join is gone.

/// ═══════════════════════════════════════════════════════════════════════════════════════════════
/// Contact-match projection (feature 020 — data-model §3). The evidence cross-brand linking runs on.
///
/// ⚠️ STORES A SALTED HASH, NEVER THE VALUE, and that is a security requirement rather than a
/// preference. A normalised-plaintext column would create a NEW PII surface outside the opaque GR8
/// snapshot: one the tier policy does not classify, masking does not cover, exports do not know
/// about, and a log could reach. A hash matches equality exactly as well and is useless if read.
/// The salt is required at boot (`CONTACT_HASH_SALT`) — an unsalted hash of an email is reversible
/// by dictionary.
///
/// Populated by the GR8 connector at roadmap 7.4 from the snapshot; seeded directly in tests and the
/// live run, because that snapshot is empty until then.
/// ═══════════════════════════════════════════════════════════════════════════════════════════════
model ContactMatch {
  account_id String
  brand_id   String
  player_id  String
  kind       String // 'email' | 'phone' — the KIND is recorded, the value never is
  value_hash String // salted hash of the NORMALISED value
  created_at DateTime @default(now())

  player Player @relation(fields: [account_id, brand_id, player_id], references: [account_id, brand_id, player_id], onDelete: Cascade)

  @@id([account_id, brand_id, player_id, kind])
  /// The matcher's only lookup: "who else has this hash, within this account". Account leads so the
  /// isolation predicate stays index-aligned and a match can never be found across tenants.
  @@index([account_id, value_hash])
}

/// A human, spanning one or more brand-scoped player records within ONE account (feature 020).
/// Created automatically when two records share a contact hash — never when they share a player_id.
model Person {
  id         String   @id @default(uuid())
  account_id String
  created_at DateTime @default(now())

  members PersonMember[]

  @@index([account_id])
}

/// A player record's participation in a person.
///
/// `linked_on` records WHICH KIND of identifier established the link ('email' | 'phone') and never
/// the value (SEC-26). A link copies NO data between members: they keep their own notes, VIP flag,
/// segment and snapshot. That is what makes an automatic decision correctable — unlinking restores
/// two independent records with nothing left behind.
model PersonMember {
  person_id  String
  account_id String
  brand_id   String
  player_id  String
  linked_on  String // 'email' | 'phone'
  created_at DateTime @default(now())

  person Person @relation(fields: [person_id], references: [id], onDelete: Cascade)
  player Player @relation(fields: [account_id, brand_id, player_id], references: [account_id, brand_id, player_id], onDelete: Cascade)

  /// `account_id` LEADS the key. Not cosmetic: the isolation extension injects an `account_id`
  /// predicate into every query on this table, and a composite index that does not lead with it
  /// cannot serve that predicate. `tests/data-model/indexes.spec.ts` enforces the rule repo-wide and
  /// is what caught this key when it was first written `[person_id, …]`.
  @@id([account_id, person_id, brand_id, player_id])
  /// A player record belongs to at most one person — enforced by the database, not by a service
  /// remembering to check.
  @@unique([account_id, brand_id, player_id])
  @@index([account_id])
}

/// One stored byte stream (feature 016, roadmap 4.9 — SEC-1/SEC-10/SEC-39).
///
/// The record that makes bytes accountable. It DESCRIBES a stored object; it never holds one — the
/// bytes live in a private S3-compatible bucket that only this service can reach (research R1/R2).
///
/// `content_type` is the type VERIFIED from the file's own content (FR-006). What the client
/// declared is compared against it and then discarded: storing the declared value would create a
/// column that looks authoritative and is not, and if the two disagreed the upload was refused, so
/// it has no readers — only future misuse.
///
/// `storage_key` is system-generated as `{account_id}/{purpose}/{uuid}` (FR-008). ⚠️ The account
/// prefix is OPERATIONAL LEGIBILITY in the bucket, never authorization. Authorization is the
/// `account_id` column plus `forAccount`; treating a path prefix as a security boundary is how
/// bucket-privacy bugs happen.
///
/// `checksum_sha256` is NOT NULL deliberately. The bytes are already in memory when the row is
/// written, so it costs nothing, and a nullable checksum nobody fills is dead weight. It detects a
/// corrupted read — it is NOT an integrity chain against someone holding storage credentials (spec
/// Assumptions), exactly as feature 015 said of the audit log.
///
/// `display_name` is a sanitized filename for display only. It can itself be PII
/// (`john_smith_passport.jpg`) → it MUST NOT appear in logs or error payloads (FR-020 / SEC-26).
///
/// NOT audited, and no audit action is defined either (spec Q2). An upload is ordinary work, like
/// posting a message; the message already answers "who sent this to the customer".
model Upload {
  id                   String    @id @default(uuid())
  account_id           String
  purpose              String // from the closed catalogue (libs/common/uploads) — never free text
  uploader_user_id     String // soft ref to auth.User.id — never joined (Principle VIII)
  content_type         String // VERIFIED from content; the declared type is never stored
  byte_size            Int
  checksum_sha256      String
  storage_key          String    @unique
  display_name         String? // sanitized, display only — never a storage identity, never logged
  derivative_key       String? // the small re-encoded copy; null for non-image purposes
  derivative_byte_size Int?
  /// Feature 017 (roadmap 4.10 — research R7/R8): when these bytes stop being allowed to exist.
  ///
  /// Set ONLY for purposes declared `ephemeral` (today: `conversation_export`), null for everything
  /// else. It is the purge predicate, and it lives HERE — on the row the credential holder owns — so
  /// deletion never depends on another service being reachable. The export record in chats_db carries
  /// the same computed value for the product-facing answer; both derive from one catalogue constant.
  expires_at           DateTime?
  state                String    @default("pending") // pending | claimed (FR-016)
  claimed_at           DateTime?
  created_at           DateTime  @default(now())

  @@index([account_id, created_at, id]) // keyset order; `id` breaks same-instant ties (the 015 lesson)
  // THE FUTURE RECLAIM PREDICATE (ADR 0015). Added now, while the table is empty — adding it later
  // means adding it to a large table. An abandoned upload is normal, not an error (spec Edge Cases).
  @@index([account_id, state, created_at])
  // Feature 017: the purge predicate — ephemeral artefacts past their window. Deliberately NOT
  // account-scoped: the sweep is a system actor with no tenant context, and it selects ids only.
  @@index([purpose, expires_at])
}

/// Audit trail entry (feature 015, roadmap 4.8 — ADR 0019; SEC-29/SEC-30; extended by 0032/SEC-AP3).
///
/// ⚠️ This model is INTENTIONALLY IDENTICAL in auth_db, users_db and chats_db. The table cannot be shared
/// (one database per service, Principle VIII) and the entry must be written inside the transaction of the
/// action it describes (spec Q3 — action and entry succeed together), so the entry lives beside its action.
/// `tests/data-model/audit-entry-identity.spec.ts` asserts the three definitions never drift apart.
///
/// APPEND-ONLY, structurally: no repository method and no controller updates or deletes a row, for any
/// role including the owner. Audit integrity is not a permission anyone can hold — the ABSENCE of the path
/// is the guarantee, and a structural test asserts it.
///
/// There is deliberately NO unique constraint. Feature 014 needed one because a scheduler could redeliver
/// an event; nothing redelivers a sensitive action. A retry is a NEW act by the operator and deserves its
/// own entry — two grant attempts, one failed, is exactly what a reviewer needs to see.
///
/// PII-free: `detail_json` is validated against a per-action-class key allow-list (libs/common/audit)
/// before the write, so a contact value or a message body is not expressible here. `target_ref` identifies,
/// never copies. Growth is unbounded until retention exists (ADR 0015 defers it; a trim job belongs with
/// the worker catalogue 7.3 — and must itself be audited as `audit.trim`).
model AuditEntry {
  id             String   @id @default(uuid())
  account_id     String
  actor_user_id  String // the REAL actor; soft ref to auth.User.id — never joined
  actor_kind     String   @default("user") // user | system
  actor_ref      String? // system actors only: which rule, under whose authority
  under_preview  Boolean  @default(false) // owner view-as marker; the previewed ROLE is never the actor
  action         String // from the closed catalogue — refused if unknown, never free text
  target_ref     String // user / rule / player / export id — identified, NEVER copied
  detail_json    Json? // PII-free, per-class allow-list validated
  created_at     DateTime @default(now())

  // The read surface orders by (created_at DESC, id DESC) so two entries in the same instant still page
  // deterministically — hence `id` in the ordering index.
  @@index([account_id, created_at, id])
  @@index([account_id, actor_user_id, created_at]) // "what did this user do"
  @@index([account_id, target_ref, created_at]) // "what happened to this record" / "who accessed this player"
}

/// The OPERATOR's own appearance settings (feature 021, roadmap 5.6 — ADR 0035 §7).
///
/// ⚠️ NOT `Player.preferences_json`. That column is the CUSTOMER's preferences — VIP portfolio data
/// about a real human being, tier `am_only`, masked from most roles. This table is an employee's own
/// theme and font size: cosmetic, self-owned, readable by nobody else, gated by no permission. Two
/// completely different things, named apart on purpose (spec 021 FR-022) — the roadmap-4.15 failure
/// shape, where "custom attributes" existed on `Player` while the requirement meant `Conversation`.
///
/// ── ONE ROW PER KEY, and that is the load-bearing decision ─────────────────────────────────────
/// A single `preferences_json` column IS the untyped bucket this feature exists to prevent:
/// validation would live only in the service, and the database would accept whatever anything wrote.
/// With a row per key the closed catalogue (libs/common/src/preferences) has a physical counterpart,
/// a partial write is an upsert of exactly the named keys — so two browser tabs changing different
/// settings cannot clobber each other without any locking — and a key retired from the catalogue is
/// simply a row the reader ignores. Feature 018 already had to NARROW `custom_attributes_json`
/// because one column holding three tiers of data could not be masked; a blob defers modelling
/// rather than avoiding it.
///
/// ── Keyed by the authenticated person, not by `Operator` ───────────────────────────────────────
/// The validated session carries the account and the auth user id, and `Operator.auth_user_id` is a
/// soft reference this project never joins. Keying here costs no lookup on a read that will run on
/// EVERY page render once 8.8 lands (Principle VII), and it works for a person who has no `Operator`
/// row yet.
///
/// No row exists until the person sets something: reading returns catalogue defaults and creates
/// nothing. There is deliberately no permission column, no scope column and no visibility column —
/// if a preference could decide what a user may SEE, it belongs in RBAC (ADR 0035's hard boundary),
/// and a column here is where someone would later put one.
model OperatorUiPreference {
  account_id   String
  auth_user_id String // soft ref to auth.User.id — resolved from the session, never joined
  key          String // a member of the closed catalogue; an unknown key is refused before the write
  value        String // a member of that key's closed value set
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  // Every access is by (account_id, auth_user_id) prefix or by the full key. The primary-key index
  // serves both; a second index here would be cargo.
  @@id([account_id, auth_user_id, key])
}

/// ═══════════════════════════════════════════════════════════════════════════════════════════════
/// Feature 026 — PLAYER ↔ ACCOUNT-MANAGER ASSIGNMENT (roadmap 5.7, scope brief §4A / ADR 0032 §4).
///
/// ⚠️ ATTACHMENT GRANTS ACCESS. A row here hands a manager the player's portfolio, preferences and
/// AM notes. It is not a "mine" marker; it is a grant of access to data about a real human being.
///
/// ⚠️ THE MANAGER IS AN **AUTH IDENTITY**, NOT AN `Operator.id` (research R1), and the READ path is
/// what decides it. The narrowing this feature introduces asks *"is the CALLER attached to this
/// player?"* on every masked player read, and the caller is identified by `x-actor-user-id` — an
/// auth identity. Storing the operator profile id would put an `auth → operator` translation on the
/// hottest read surface in the product, to answer a question that could have been answered
/// directly. The profile is still VALIDATED at write time; it is simply not the key.
///
/// This also keeps the identifier consistent with group membership, presence and every `actor_ref`
/// in the transition stream. `Conversation.assignee_operator_id` is the one outlier that nothing
/// validates (feature 024 recorded it); adding a second person-identifier here would spread exactly
/// the inconsistency that feature declined to spread.
///
/// ⚠️ NOT A GROUP (ADR 0039 §10). Per-player, deliberately narrower than membership of a unit.
/// ═══════════════════════════════════════════════════════════════════════════════════════════════
model PlayerAssignment {
  id         String @id @default(uuid())
  account_id String

  /// The player, by the FULL identity feature 020 established. A bare `player_id` names two people:
  /// the same platform id under two brands is routinely two different human beings.
  brand_id  String
  player_id String

  /// Soft ref to auth.User.id — the manager. Never joined across a service boundary.
  am_auth_user_id String

  /// ⚠️ WHO DECIDED, which is NOT the same as who looks after the player. Self-assignment makes the
  /// two equal most of the time, and that is exactly why they are separate columns: the
  /// abnormal-volume signal (FR-016) is computed from THIS one, and it matters most in precisely the
  /// case where they are equal — somebody attaching a hundred players to themselves.
  assigned_by String

  started_at DateTime  @default(now())
  /// NULL = ACTIVE. Detaching CLOSES a period; it never deletes one.
  ended_at   DateTime?
  ended_by   String?

  /// ⭐ THE UNIQUE INDEX IS **PARTIAL**, filtered to `ended_at IS NULL` — written by hand in the
  /// migration, because Prisma has no first-class partial unique index. `@@unique` here would be
  /// wrong: it would forbid a player from EVER having had a second manager, which is the opposite of
  /// FR-003's additive history.
  ///
  /// The filtered index is what lets two requirements that look opposed both hold: the database
  /// refuses a second ACTIVE manager (🅿 FR-002) while every closed period stays exactly where it
  /// was (FR-003). And it is what makes the operator's *"one per player is a leaning, not a lock"*
  /// real — widening later is `DROP INDEX`, a dropped constraint rather than a reshape.
  ///
  /// `tests/data-model/assignment-history-is-additive.spec.ts` asserts the filter exists in the SQL,
  /// because a schema comment is not an index.
  ///
  /// ⚠️ There is deliberately no `active` BOOLEAN. `ended_at IS NULL` already says it, and a flag
  /// beside a timestamp is two facts that can disagree.
  /// "Who looks after this player?" — the read the narrowing performs.
  @@index([account_id, brand_id, player_id, ended_at])
  /// "My players" — the 9.10 portfolio list, keyset-paged.
  @@index([account_id, am_auth_user_id, ended_at])
  /// "Who attached how many, and when?" — this index exists ONLY for the abnormal-volume question
  /// (FR-016). Without it the answer needs a scan, which is how a monitoring signal quietly becomes
  /// something nobody ever runs.
  @@index([account_id, assigned_by, started_at])
}

/// ═══════════════════════════════════════════════════════════════════════════════════════════════
/// Feature 025 — AGENT PRESENCE, FOR ROUTING ONLY (roadmap 5.9, ADR 0042 §7 / U4).
///
/// Keyed on `auth_user_id`, NOT on `Operator.id`, and that is a decision rather than a convenience
/// (research R3). Group membership keys on the auth identity; every actor reference in the
/// transition stream is an auth user id; and feature 024 recorded `Conversation.assignee_operator_id`
/// as the ONE outlier that nothing validates and that may be misnamed. Minting a second
/// person-identifier into the analytics stream now would double down on the identifier already
/// flagged as suspect. `OperatorUiPreference` above keys the same way, for the same reason.
/// ═══════════════════════════════════════════════════════════════════════════════════════════════

/// One row per person. Absence of a row means `offline` — see FR-011: presence is a statement about
/// a LIVE SESSION, and absent a session `offline` is the only honest answer. A read never
/// materialises a row (the feature-021 rule: absence is answered, not written).
model OperatorPresence {
  account_id   String
  auth_user_id String // soft ref to auth.User.id — resolved from the session, never joined

  /// online | transfers_only | away | offline. Validated against @crm/common/presence at write time.
  state String

  /// ⚠️ WHY the current state was set: manual | auto_inactivity | admin. NULL = never set.
  ///
  /// This lives on the ROW and not only in the history, and it is the one place this feature pays
  /// for storing the same fact twice. FR-016 says a heartbeat may raise availability ONLY from a
  /// state the sweep itself set — otherwise a browser left open would undo a person's own "Lunch",
  /// and worse, would undo a supervisor's correction using the very stale session that made the
  /// correction necessary. Answering "how did this state come to be?" from the append-only stream on
  /// every heartbeat would be a scan on the hottest write path in the feature.
  ///
  /// The history says what HAPPENED; this column says what is TRUE NOW. Different questions.
  last_cause String?

  /// Last heartbeat. NULL = never active. The sweep's predicate reads this and nothing else.
  last_seen_at DateTime?

  /// Soft ref to PresenceLabel.id. Cleared on delete, never cascaded: removing a decoration must
  /// never change who receives work (FR-028).
  label_id String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  /// ⚠️ THERE IS DELIBERATELY NO `available` BOOLEAN HERE.
  /// Availability is DERIVED — `operator.active AND stateAllows(ask) AND NOT blocked` — and there are
  /// TWO asks (a new push from the router versus a transfer handed over by a human), which
  /// `transfers_only` answers differently. One stored boolean could not be correct for both, and it
  /// would be the copy that goes stale.
  @@id([account_id, auth_user_id])
  /// The sweep's query: "who has been quiet longer than the threshold?" (Principle VII).
  @@index([account_id, last_seen_at])
}

/// A channel the operator has switched OFF.
///
/// ⚠️ THERE IS DELIBERATELY NO `available` COLUMN HERE — **a row's existence IS the block**, and
/// switching a channel back on DELETES the row.
///
/// The name says it too: `OperatorChannelBlock`, not `…Availability`. A table able to store
/// `available: true` immediately raises "does an explicit true beat the presence state?", and the
/// answer must be no, because a channel switch may only ever subtract (FR-019). Rather than write
/// that rule down and hope, the column that could express the violation does not exist.
///
/// This is the same technique as `GroupPermission` in feature 024, applied to the mirror-image
/// problem: there a group may only ever GRANT, so there is no `granted` column to write `false` into;
/// here a switch may only ever DENY, so there is no `available` column to write `true` into. Both
/// tables lean opposite ways for reasons that are opposite in exactly the same way, and
/// `tests/data-model/channel-block-is-negative-only.spec.ts` asserts BOTH absences together — so the
/// day somebody copies one model to make the other, it fails.
///
/// `channel` is an OPAQUE key. This feature deliberately introduces no channel vocabulary
/// (research R8): `Conversation.channel` is still a nullable open string, and roadmap 4.17 / Phase 6
/// own settling it. A mistyped key therefore switches off a channel nobody routes to, and a channel
/// invented later becomes switchable with no migration.
model OperatorChannelBlock {
  account_id   String
  auth_user_id String
  channel      String
  created_at   DateTime @default(now())

  @@id([account_id, auth_user_id, channel])
}

/// An administrator-editable word displayed beside a state (`Break`, `Lunch`, `Meeting`, `VIP task`).
///
/// A TABLE and not a closed catalogue, for two reasons pointing the same way: ADR 0042 §7 requires
/// administrators to edit the set, which a compile-time catalogue cannot allow; and every closed
/// catalogue in this product is closed because a new member CHANGES BEHAVIOUR, while a new label must
/// change none. Routing never sees a label — proven by
/// `tests/contracts/presence-label-never-branched-on.spec.ts`.
model PresenceLabel {
  id         String   @id @default(uuid())
  account_id String
  /// Operator-authored. No code branches on it, ever.
  name       String
  /// Exactly one of the four states.
  state      String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  /// Two labels are always distinguishable — the same guarantee `Group` carries in auth_db.
  @@unique([account_id, name])
  @@index([account_id])
}

/// ── The SECOND writer of the durable transition stream, and the first outside `chats` ────────────
///
/// Column-for-column identical to `chats.ConversationTransition`. That is a REQUIREMENT (FR-004),
/// not a coincidence: the B2 aggregate store reads *one logical stream*, and two shapes would mean it
/// must know both, permanently. `tests/data-model/one-transition-envelope.spec.ts` compares the two
/// models directly rather than trusting two hand-written schemas to agree.
///
/// It is a SEPARATE TABLE and not a shared one because U7 forbids a shared cross-service table and
/// Principle VIII makes it impossible — a cross-service table is a cross-service join by another
/// name. "One logical stream" is achieved downstream, in B2.
///
/// Append-only, and never trimmed: no update path and no delete path in any service
/// (`tests/transitions/append-only.spec.ts`).
model OperatorTransition {
  id         String @id @default(uuid())
  account_id String

  /// From the closed catalogue in @crm/common — refused at write time if unknown, never free text.
  type String

  /// When it HAPPENED (millisecond precision, UTC) — the ordering key. Distinct from created_at,
  /// which is when the row was written; they differ only under retry.
  occurred_at DateTime

  /// user | system | integration. Never blank for a system act: the sweep names itself.
  actor_kind String
  /// The auth user id, or the job that acted. Soft ref — never joined across a service boundary.
  actor_ref  String?

  /// `operator` here. The KIND of subject, not the table it was read from — `subject_id` is the AUTH
  /// USER ID (research R3), the same identifier `actor_ref` uses everywhere in this stream.
  subject_kind String
  subject_id   String

  /// Minimal and TYPED — ids and enums only, validated against the per-type allow-list in
  /// @crm/common. A label's TEXT, a session id and any screen/panel detail are all inexpressible
  /// here, not merely discouraged (Principle IV / SEC-26 / FR-037).
  payload_json Json?

  /// The reporting dimensions AS THEY WERE at this instant. An operator transition has no brand and
  /// no assignee, so those are ABSENT rather than null — a null would claim the dimension existed and
  /// was empty, and a later feature must be able to start writing one going forward with no backfill.
  dims_json Json

  /// Ties this to the audit entry produced by the same act (the supervisor override is the one
  /// presence act that produces both), without either becoming the other's source of truth.
  correlation_id String

  created_at DateTime @default(now())

  /// Ordering + the watermark a later aggregator reads forward on. `id` breaks same-instant ties, so
  /// two transitions in the same millisecond still page deterministically (the 015 lesson).
  @@index([account_id, occurred_at, id])
  /// "Reconstruct this person's day" — the operator-shaped equivalent of the conversation index.
  @@index([account_id, subject_id, occurred_at])
  /// "Every presence change in this range".
  @@index([account_id, type, occurred_at])
}
