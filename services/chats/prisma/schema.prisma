// Chats service schema — chats_db (feature 006, roadmap 2.2/2.3).
// DB-per-service (ADR 0029): targets ONLY chats_db via the service's own DATABASE_URL +
// role. Per-service generated client path (research R1). Chatwoot is the blueprint for
// these shapes (read-only reference; nothing copied). Conversations carry the reserved
// classification fields (ADR 0027) + the player_id feed key (ADR 0032).
// Model surface reviewed in specs/006-contracts-data-model/data-model.md (Chats section).

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// The ticket. Carries tenant + brand scope, the player_id feed key, and the reserved
/// classification fields (ADR 0027) — all nullable so an unclassified ticket is valid (FR-012).
/// brand_id / player_id / assignee_operator_id are SOFT refs (owned by other services; resolved
/// via gRPC, never joined — Principle VIII).
model Conversation {
  id                   String   @id @default(uuid())
  account_id           String
  brand_id             String // soft ref to brands.Brand.id
  player_id            String? // soft ref / feed key; nullable until linked
  /// ⭐ W24 (R43): the human-facing ticket NUMBER — per-account sequential, assigned inside the
  /// create transaction from `ConversationReferenceCounter`, backfilled once in created_at order.
  /// The old "format id–date–channel TBD" idea is dead: the operator's own example is a bare
  /// number (`[1043] Тема`). Stays String on the wire; uniqueness per account is structural below.
  reference            String?
  /// The status KEY — a row in `ConversationStatus`, not a value in an enum (feature 032, ADR 0040).
  /// The composite foreign key below is what makes "every status resolves to a category" structural:
  /// there is no way to store a word the account has not configured, so no read has to cope with one.
  status               String   @default("open")
  priority             String?
  /// Feature 031 (roadmap 4.19): the URGENCY rank of `priority`, stored so the queue can be ordered by
  /// meaning rather than by the alphabet (`high < low < normal` is correct as strings and nonsense as
  /// urgency). 0 = no priority, or a word the product does not recognise — deliberately NOT "normal".
  ///
  /// ⚠️ Contains NO time. The other half of urgency (how long this has waited) is read at query time from
  /// `updated_at`, so there is no stored value that can go stale as the clock moves — see
  /// `src/conversation/urgency.ts`. Written only via `priorityWrite()`; a structural guard fails when any
  /// path writes the word by hand.
  priority_rank        Int      @default(0)
  /// ── Feature 033 (roadmap 6.1/6.4, subpoint 2.1e): the ARRIVAL CHANNEL, now typed ──────────────
  ///
  /// Values are the closed vocabulary in `libs/common/src/channels/kinds.ts` — `api | email | messenger`.
  /// The column keeps its name and its type: the 033 migration rewrites the VALUES in place (`chat` →
  /// `api`) rather than adding a `channel_kind` column, so the wire field is unchanged and nothing
  /// downstream breaks. Two columns for one fact would be two sources of truth, and the loser would be
  /// whichever the next reader did not notice.
  ///
  /// ⚠️ **STILL NULLABLE, and that is load-bearing.** NULL means *no arrival channel* — a ticket an agent
  /// raised, or a seeded one — which is an ABSENCE, not a fourth kind. About one in six rows are NULL and
  /// the 029 Inbox filter depends on them staying reachable: see the `channel` filter note in
  /// `conversation.repository.ts`, which warns that a `channel: null` predicate must never be introduced.
  /// Inventing an `internal` kind to fill a legitimate absence would be a lie in the data.
  channel              String?
  assignee_operator_id String? // soft ref to users.Operator.id
  // Reserved classification (ADR 0027) — all nullable (unclassified is valid, FR-012):
  category             String?
  sub_category         String?
  classified_by        String? // "ai" | operator id | null
  /// ⭐ Feature 037 (roadmap 4.15 — W30): the FORM this conversation is filed under — a row in
  /// `Form`, chosen by an agent (or nobody: NULL is the valid unfiled state, like the columns
  /// above). A human's choice of a category-bearing form writes `category` + `classified_by` in the
  /// same act (U9). The composite FK below is the `status` shape: forms are per-account
  /// configuration, so a bare reference would let one tenant's ticket stand on another's vocabulary.
  form_key             String?
  /// Feature 031: when this conversation started waiting for capacity. NULL = not waiting.
  /// See the `@@index([account_id, backlog_at])` note below for why the drain never rewrites it.
  backlog_at           DateTime?
  /// Feature 031: when the drain first found that this waiting work can reach NOBODY. NULL = it can.
  ///
  /// ⚠️ It exists so the audited `conversation.unroutable` event is written ONCE PER CONDITION rather
  /// than once per tick. The drain runs every 30 seconds; without this stamp a desk left un-routable
  /// over a weekend would write ~20 000 identical audit entries, and an alarm that repeats is an alarm
  /// nobody can read. Cleared the moment the condition clears — which is also what makes "it resolves"
  /// a fact on the row instead of a hope.
  unroutable_since     DateTime?

  // ── W27 / feature 036 (roadmap 9.16): the THIRD place — out of every queue, not gone ───────────
  //
  /// `suspended` | `deleted`. NULL = ordinary (every existing row; no backfill). NOT a status: statuses
  /// drive the R39 category rail, and this is orthogonal to that axis — every query that FEEDS WORK
  /// (lists, unseen count, backlog, pool load, exports) excludes non-NULL via the one predicate in
  /// `src/conversation/shelf.ts`. Named `shelved`, not `held`: `assignment/capacity.ts` already uses
  /// "held" for an operator's open work, and one word with two meanings in one service is a trap.
  ///
  /// ⚠️ The trio is set and cleared TOGETHER (state=NULL ⇒ at=NULL ∧ by=NULL). Restore writes ONLY
  /// these three columns back to NULL — that nothing else is written is what makes "returns exactly
  /// as it was" structural. The single writer is `SetConversationShelf`.
  shelved_state        String?
  shelved_at           DateTime?
  shelved_by           String? // operator id (soft ref to users.Operator.id) — who shelved it

  // ── Feature 033 (roadmap 6.1, ADR 0044 §1) — WHO WROTE, and the honest answer when we cannot tell ──
  //
  /// `identified` | `unidentified`. NULL for every conversation created before this feature.
  ///
  /// ⚠️ **STORED, NOT DERIVED FROM `player_id`,** and the difference is the requirement. A null
  /// `player_id` cannot distinguish *"resolution ran and matched nobody"* from *"resolution never ran"* —
  /// and those are opposite facts: the first is a ticket the manual attach (W9) must work on, the second
  /// is a ticket nothing has looked at yet. ADR 0044 §1 forbids implying the unidentified state by a
  /// blank precisely because a blank is what their current Zendesk shows, and nobody can tell from it
  /// whether the data is missing or merely unmapped.
  ///
  /// Forbidden alongside it (ADR 0044 §1): `***`-style fillers and auto-generated stand-in names
  /// (`Web User 6a5df…`). The state is a value a reader can act on; it is not a decorated absence.
  identity_state       String?
  /// Opaque soft ref to `users.ChannelParticipant.id` — the envelope a reply needs.
  ///
  /// ⚠️ **THE ADDRESS IS NOT HERE, AND MUST NEVER BE.** Replying to an email ticket needs the address the
  /// customer wrote FROM, which cannot come from a hash and cannot come from the player's registered
  /// address (they may differ, and answering the registered one would send a stranger's conversation to
  /// them). So a clear-text contact value must exist somewhere — and it exists in `users`, which owns
  /// contact values, holds the hash salt and has the field-tier allow-list. `ContactMatch`'s own comment
  /// names what a column here would create: *"a NEW PII surface: one the tier policy does not classify,
  /// masking does not cover, exports do not know about, and a log could reach."* chats holds a handle.
  channel_participant_id String?
  /// Set when this ticket exists because a reply arrived on a thread whose ticket was already `closed`.
  ///
  /// Soft ref within this table (no FK: the parent may be archived under a retention policy that does not
  /// exist yet, and a hard reference would make that policy a schema change). `closed` is final — reviving
  /// it months later would return it to routing, to the SLA clock and to a reporting period already
  /// counted — so the thread continues in a new ticket that says which one it continues. A `solved` ticket
  /// reopens instead, and leaves this NULL.
  continues_conversation_id String?

  created_at           DateTime @default(now())
  updated_at           DateTime @updatedAt
  // ── Feature 022 (roadmap 4.13): the CONTACT facts, maintained on the message write ─────────────
  //
  // ⚠️ `updated_at` above is NOT one of them, and that is the whole reason these exist. It is a Prisma
  // `@updatedAt` column, so relabelling, reassigning or resolving bumps it — a player card built on it
  // reports our own internal work as customer contact, and looks right doing so.
  //
  // Written inside `MessageRepository.post`'s transaction from the created message's own `created_at`,
  // for the column `message/contact-stamp.ts` selects (research R1/R2). NULL means "this never happened
  // in this conversation" — a conversation whose only message is a private note has both null and is
  // still counted. Never rendered as an epoch date.
  //
  // NO INDEX on either, deliberately: they are projected and aggregated, never filtered on. The reads
  // narrow by `(account_id, player_id)`, which is already indexed below; indexing these would add write
  // cost on the busiest path in the product for no read.
  last_inbound_at      DateTime? // most recent CUSTOMER-authored message
  last_outbound_at     DateTime? // most recent PUBLIC staff reply (a private note is inert)

  // ── Feature 023 (roadmap 4.18): the human-readable title ───────────────────────────────────────
  //
  // Derived from the CUSTOMER's own first substantive words, then FROZEN. Their Zendesk takes the
  // first message literally, so lists read as "привет", "???" and mid-word fragments — unscannable.
  //
  // `subject_source` is what makes the freeze enforceable: `manual` means a human wrote it and NO
  // automated writer may touch it again, ever. Null means the derivation window is still open.
  //
  // Deliberately NOT here: `subject_set_by` / `subject_set_at`. Who set it and when are answered by
  // the `conversation.subject_set` transition, so the hot row does not duplicate actor bookkeeping.
  //
  // NO INDEX ON THE TITLE, deliberately: search must never depend on the subject (R10/U19) — it is
  // model-generated and human-editable, so navigation built on it is navigation built on a mutable,
  // occasionally wrong string. Filtering runs on message content, labels, category and player ids.
  //
  // There IS an index on the WINDOW (`subject_source, created_at`, below), which is a different thing:
  // the timeout sweep's predicate is `subject_source IS NULL AND created_at <= …`, and without it that
  // is a sequential scan over every conversation ever created, once a minute (research R5).
  subject              String?
  // `auto` = we derived it · `manual` = a person typed it · `source` = ⭐ feature 033: the SOURCE named
  // it (an email's `Subject` header, FR-028) and no automated writer may overwrite it. NULL = the
  // derivation window is still open.
  subject_source       String?

  // ── Feature 024 (roadmap 5.3, ADR 0039 §5.3): WHICH DESK this conversation was routed to ───────
  //
  // Soft ref to `auth.Group.id` — never joined (Principle VIII). Written by auto-assignment when the
  // caller names a group; NULL for everything routed the old way, so the migration needs no backfill
  // and the caller-supplied candidate path is unchanged.
  //
  // It is the joinable FACT both group bindings need. An automation scoped to a group matches on it,
  // which is also what makes a DANGLING SCOPE fail closed with no lookup: chats cannot see auth's
  // tables, and a deleted group is never again the routed group of anything — so a scoped rule
  // silently becoming an everything rule is unreachable rather than merely avoided.
  //
  // Indexed: "show me this desk's work" is a foreseeable list read, and this is a high-cardinality
  // column on the largest table in the system (Principle VII).
  routed_group_id      String?

  messages Message[]
  labels   ConversationLabel[]
  /// W5 (roadmap 4.19): who has OPENED this conversation — the fact under the agent rail.
  read_marks ConversationReadMark[]
  /// Feature 032: `(account_id, status)` → `ConversationStatus(account_id, key)`. Composite on purpose —
  /// statuses are per-account configuration, so a bare `status` reference would let one tenant's ticket
  /// stand on another tenant's vocabulary.
  status_def ConversationStatus @relation(fields: [account_id, status], references: [account_id, key])
  /// Feature 037: `(account_id, form_key)` → `Form(account_id, key)` — optional, same composite
  /// reasoning as `status_def` one line up. Deliberately UNINDEXED beyond the FK's own needs: no
  /// list filters by form this block (research D13 — the index arrives with its first reader).
  form_def Form? @relation(fields: [account_id, form_key], references: [account_id, key])
  /// Feature 037: the values this conversation holds for custom fields (one row per field).
  field_values ConversationFieldValue[]

  // ⭐ W24: two tickets of one account can never share a number — a claim the UI makes in every
  // list row, so it is a constraint rather than a convention. (Postgres permits multiple NULLs,
  // which is what lets the backfill migration run before anything relies on it.)
  @@unique([account_id, reference])
  @@index([account_id, status])
  @@index([account_id, player_id])
  @@index([brand_id])
  @@index([player_id])
  // Feature 023: the title-window sweep, and ONLY that. Deliberately not account-scoped — the sweep
  // has no caller and therefore no account (the `sla-sweep.repository.ts` reasoning applies verbatim),
  // so leading with `account_id` would make the index unusable for the one query it exists for.
  @@index([subject_source, created_at])
  // Feature 024: the by-desk list read, and the automation engine's scope filter.
  @@index([account_id, routed_group_id])
  // ── Feature 029 (roadmap 9.2): the Inbox's default order ───────────────────────────────────────
  //
  // The inbox list orders by `updated_at` (both of its two orders do), under a keyset predicate on the
  // same column. Without this index that is a sort over a scan of the largest table in the system,
  // against a stated 2 s budget for the first screenful of a 4 500-row view (Principle VII).
  //
  // ⚠️ `updated_at`, NOT a "last activity" column — there is no such column, and the wire field of that
  // name is this one renamed (research R7). The two feature-022 columns above ARE customer contact and
  // stay deliberately unindexed: they are projected, never ordered or filtered on.
  //
  // Account-scoped leading, like the other list indexes here: every read is confined to one account
  // (Principle I), so `account_id` is the first thing the planner can use.
  @@index([account_id, updated_at])
  // Feature 031 (roadmap 4.20): the drain reads `backlog_at IS NOT NULL` oldest-first. Declared here to
  // match the shipped migration — the column arrived with its index and the model said so only in prose.
  @@index([account_id, backlog_at])
  // ── Feature 031 (roadmap 4.19): the URGENCY order ──────────────────────────────────────────────
  //
  // `(priority_rank DESC, updated_at ASC, id)` under a keyset predicate on the same columns. Without the
  // index this third order is a sort over a scan of the largest table in the system — the same budget
  // argument as the `updated_at` index above, and the reason the rank is stored at all.
  @@index([account_id, priority_rank, updated_at])
  // ── Feature 033: the unidentified work queue ────────────────────────────────────────────────────
  //
  // "Show me the tickets nobody has been matched to" is W9's whole job — the manual attach exists
  // because this feature creates these tickets. A low-cardinality column would not normally earn an
  // index on the largest table in the system; this one earns it because that read is foreseeable and
  // narrow, and because without it the query is a scan every time an agent opens the queue.
  @@index([account_id, identity_state])
  // ── ⭐ W31 / feature 038 (ADR 0043 §4, SEC-PV2): the offboarding handover's one query ───────────
  //
  // «Every open conversation this operator holds» had no index: the assignee is written on every
  // ticket and read by the capacity counters, but always alongside an account+status predicate that
  // could carry the plan. The handover asks the question the other way round — one operator, all of
  // their work — and at 3.6–4.5 k rows per account that is a scan at exactly the moment somebody is
  // being offboarded and a human is waiting for the answer.
  @@index([account_id, assignee_operator_id])
  // ── W27 / feature 036: the shelf buckets ────────────────────────────────────────────────────────
  //
  // Serves ONLY the two bucket lists (`shelved_state = 'suspended'|'deleted'`). The common path — the
  // `shelved_state IS NULL` exclusion every work-feeding query adds — deliberately has no index: NULL
  // is ~every row, and the existing (account_id, …) indexes already carry those queries. The shipped
  // migration makes this PARTIAL (`WHERE shelved_state IS NOT NULL`); Prisma cannot express that, so
  // the model declares the columns and the migration is the truth (the backlog_at precedent above).
  @@index([account_id, shelved_state, shelved_at])
}

/// ⭐ A configured way in and out, for exactly one account and one brand (feature 033, roadmap 6.5).
///
/// ── What a channel is, and what it is not ────────────────────────────────────────────────────────
/// It is the addressable, per-tenant *thing* — a webhook key, a mailbox address. It is **not** a
/// `channel_kind`: the KIND is the closed vocabulary in code that logic may branch on, the CHANNEL is
/// configuration. Same two-level split as statuses and their categories (ADR 0040), and for the same
/// reason: the admin screen at roadmap 3.10 / block W15 must be able to add one with an INSERT.
///
/// ── ⚠️ THERE IS NO SECRET COLUMN, deliberately ──────────────────────────────────────────────────
/// Verifying an HMAC needs the KEY MATERIAL, so unlike feature 028's invite token a channel secret
/// cannot be stored as a hash — and a recoverable secret at rest needs encryption plus a key-management
/// story that one MVP channel does not justify. The secret therefore lives in configuration
/// (`CHANNEL_SECRETS`), keyed by `key`, and this row identifies the channel and holds nothing secret.
///
/// The cost is stated rather than hidden: **rotation is a redeploy until W15 exists.** `enabled = false`
/// is the immediate stop button in the meantime, and a disabled channel is answered exactly like an
/// unknown one — an attacker must not be able to tell a retired key from a nonexistent one.
///
/// `brand_id` is a SOFT ref to `brands.Brand.id` — never joined (Principle VIII). It is the single most
/// security-relevant field here: the intake's brand comes from THIS row, never from the payload.
model Channel {
  id         String   @id @default(uuid())
  account_id String
  brand_id   String // soft ref to brands.Brand.id
  /// One of `api | email | messenger` — the closed vocabulary in libs/common. Never free text.
  kind       String
  /// The public identifier a delivery names, and the lookup key for its secret in configuration.
  key        String
  /// The channel's OWN address (an email channel's mailbox). Ours, not a customer's — not PII.
  address    String?
  /// The stop button before the admin screen exists. A disabled channel refuses like an unknown one.
  enabled    Boolean  @default(true)
  /// ── W5 (roadmap 2.4, subpoint): the DESK this channel's new tickets are pushed to ─────────────
  ///
  /// Soft ref to auth.Group.id. When set, intake enqueues every NEWLY CREATED conversation into the
  /// one ordered backlog with this desk, and the existing drain (feature 031) routes it to a member
  /// with capacity — that is the whole of "a ticket from a channel reaches a specific agent".
  ///
  /// ⚠️ NULL means "this channel is not push-routed", which is an honest state, not a default desk:
  /// a deployment that has not decided must stay quiet (the same reasoning as `Group.routable`
  /// defaulting to false in auth). The W15 admin screen is where a human sets it; until then the
  /// seed does, explicitly.
  default_group_id String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  intakes ChannelIntake[]

  /// The verification lookup: a delivery names a key, within an account.
  @@unique([account_id, key])
  /// One channel per kind per brand — the MVP's "one key and one address" (subpoint 2.1h). A second
  /// mailbox for one brand is a W15 feature, and it will relax this unique deliberately rather than
  /// discovering that two rows silently competed for the same inbound mail.
  @@unique([account_id, brand_id, kind])
  @@index([account_id])
}

/// ⭐ The ledger that makes intake AT-MOST-ONCE (feature 033, roadmap 6.1 — FR-012/FR-013).
///
/// ── This table is the feature ────────────────────────────────────────────────────────────────────
/// `@@unique([channel_id, external_event_id])` is the whole of duplicate suppression. The write path
/// **inserts first** and reads a unique violation (Prisma `P2002`) as *"already accepted"*. A
/// `findFirst` followed by a `create` would be a race against the provider's own retry — which arrives
/// concurrently BY DESIGN, because that is what every webhook provider does when its acknowledgement is
/// lost. This project has paid for that lesson twice already: feature 014's attachment link and feature
/// 031's assignment budget were both check-then-write, and both were found on a live run.
///
/// ── Why refusals are rows here and nowhere else ──────────────────────────────────────────────────
/// FR-010 says a refused delivery leaves NO product data — no conversation, no message, no upload. A
/// ledger row is not product data: it is the audit of a rejection, and it carries no payload. Without
/// it, a refusal is indistinguishable from a delivery that never arrived, and those have opposite
/// causes — one is our rejection, the other is somebody else's outage.
model ChannelIntake {
  id                 String   @id @default(uuid())
  account_id         String
  channel_id         String
  /// What the adapter derived. A delivery with no derivable id is REFUSED, never given a generated one:
  /// a generated id makes every replay look new, which is the failure this table exists to prevent.
  external_event_id  String
  /// What it produced. NULL on a refusal — and on a duplicate, where the first row holds them.
  conversation_id    String?
  message_id         String?
  /// `accepted` | `refused`.
  outcome            String
  /// A CLASS, never a sentence: `signature` · `unparseable` · `loop` · `no_event_id` ·
  /// `unknown_channel` · `disabled` · `no_status_configured` · `replay_window`.
  refusal_class      String?
  created_at         DateTime @default(now())

  channel Channel @relation(fields: [channel_id], references: [id], onDelete: Cascade)

  /// ⭐ THE constraint. See the model note — this is not an optimisation of a check done in code, it is
  /// the only place the decision can safely be made.
  @@unique([channel_id, external_event_id])
  /// "What has this channel been sent lately, and what did we do with it" — the diagnostic read.
  @@index([account_id, created_at])
}

/// ⭐ One intent to deliver one conversation message (feature 033, roadmap 6.4 — FR-036…FR-040).
///
/// ── Feature 028's proven mechanics, in the service that owns conversation mail ───────────────────
/// Claim-and-lease (`pending → sending` as a conditional update, stale-claim reclaim, delete on
/// success). The mechanics are reused; the STORE is not: auth owns identity mail, chats owns
/// conversation mail, and no service reads another's tables (Principle VIII).
///
/// ── Two deliberate differences from 028, both of them corrections ────────────────────────────────
/// 1. **`next_attempt_at` exists.** 028 sets a failed row back to `pending` and the very next tick
///    retries — no growing gap. FR-039 requires backoff, so the claim predicate is
///    `status = 'pending' AND next_attempt_at <= now`.
/// 2. **THERE IS NO RECIPIENT COLUMN, and nothing here is ever logged with an address.** 028 logs
///    `to=<address>` and defends it correctly: that recipient is an operator's own work address. Here the
///    recipient is a CUSTOMER, which is precisely what anti-pitching protects. The envelope is fetched
///    from `users` at send time and never stored, never logged.
///
/// ── Deleted on success, like 028 — with one thing rescued first ──────────────────────────────────
/// This is a queue, not an archive; the history is the message itself. But the `Message-ID` we issued
/// must outlive the row, because a customer's reply will quote it weeks later — so it is written to
/// `Message.external_id` BEFORE the row is removed. Getting that order wrong would make threading work
/// in tests and fail in production, where the row is actually deleted.
model OutboundMessage {
  id               String    @id @default(uuid())
  account_id       String
  conversation_id  String
  message_id       String
  channel_id       String
  /// `pending` | `sending` | `failed`. There is no `sent`: a sent row is deleted.
  status           String    @default("pending")
  attempts         Int       @default(0)
  /// The backoff clock — the delta from 028. `now + base * 2^attempts`, bounded.
  next_attempt_at  DateTime  @default(now())
  /// A CLASS from `libs/common/src/mail` — never the relay's own sentence, which quotes the envelope.
  last_error_class String?
  /// Also the stale-claim cutoff: a claim older than the lease means the claimer died.
  last_attempt_at  DateTime?
  created_at       DateTime  @default(now())

  /// ⭐ ONE MESSAGE, ONE DELIVERY — structurally. FR-036 says a public reply creates exactly one intent,
  /// and this is what makes "exactly one" a property of the database rather than of the caller's care.
  /// A retry of the request that posted the message cannot produce a second copy for the customer.
  @@unique([message_id])
  /// The claim query, in its exact shape.
  @@index([status, next_attempt_at])
  @@index([account_id])
}

/// ⭐ One configured ticket status of one account (feature 032, roadmap 4.16 — ADR 0040).
///
/// ── Configuration, not a vocabulary in code ──────────────────────────────────────────────────────
/// The `category` is a member of the CLOSED catalogue in `libs/common/src/statuses/categories.ts` and
/// is the only part machine logic may branch on. Everything else here is a supervisor's editorial
/// choice, which is what lets the authoring screen (roadmap 3.14 / block W15a) ship with no migration:
/// adding *Waiting for finance* is an INSERT.
///
/// ── Two names, both required (ADR 0040 §2) ───────────────────────────────────────────────────────
/// `agent_name` is what the team sees; `end_user_name` is what the player sees. ⚠️ The second has NO
/// CONSUMER UNTIL PHASE 6 (U10) and is populated anyway — dual naming cannot be retrofitted from data,
/// because a single historical name is ambiguous about which audience it was for.
///
/// ── Why nothing is ever deleted ──────────────────────────────────────────────────────────────────
/// `active = false` retires a status. There is no delete path: conversations reference the key, so
/// removing the row would either orphan history or force a bulk rewrite of tickets nobody touched.
/// ⭐ W25 (R23 / 9.12) — "this operator last OPENED the Inbox at". One row per (account, operator),
/// upserted by the reset act; the unread count is DERIVED (rows in my Inbox slice with
/// `created_at > opened_at`), never accumulated — which is what lets a reload answer from here.
/// ⓘ Deliberately NOT a column on ConversationReadMark: that fact is per-conversation ("he opened
/// THIS one"); this one is per-surface ("he looked at the LIST"), and the operator's counter rule
/// («Inbox открыт — не растёт, потому что он сразу просмотрен») is about the list, not any row.
model InboxOpenMark {
  account_id  String
  operator_id String
  opened_at   DateTime @default(now())

  @@id([account_id, operator_id])
}

/// ⭐ W24 (R43) — the per-account ticket-number counter. `last` is the last ASSIGNED number, so a
/// fresh account's first ticket is 1. Incremented atomically (INSERT … ON CONFLICT DO UPDATE via
/// Prisma upsert on the PK) inside the same transaction that creates the conversation — a number is
/// never burned by a create that failed, and two concurrent creates cannot share one. Per-account
/// rather than a global sequence ON PURPOSE: a shared sequence leaks one tenant's ticket volume to
/// another through the gaps (Principle I).
model ConversationReferenceCounter {
  account_id String @id
  last       Int
}

model ConversationStatus {
  id            String   @id @default(uuid())
  account_id    String
  key           String
  /// new | open | pending | on_hold | solved | closed — the closed catalogue (never free text).
  category      String
  agent_name    String
  end_user_name String
  /// Retired statuses stay readable so an old ticket still renders a label; they are not settable.
  active        Boolean  @default(true)
  /// Display order within the account. Seeded by tens so a later insert needs no renumbering.
  order         Int      @default(0)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  conversations Conversation[]

  /// The key IS the identity within an account — and it is what the conversation FK stands on.
  @@unique([account_id, key])
  /// The catalogue read: one account's statuses, in display order, active-first filterable.
  @@index([account_id, active, order])
}

/// An entry within a conversation. `private` flags an internal note; realtime-scoping so it
/// never leaks to a customer connection is enforced later (SEC-13) — here the flag is reserved.
model Message {
  id              String   @id @default(uuid())
  account_id      String
  conversation_id String
  author_type     String // operator | player | system
  author_id       String? // soft ref (operator/player)
  body            String
  private         Boolean  @default(false)
  // Operator-id soft refs on a PRIVATE note (feature 012, roadmap 4.2). Capture-only: existence /
  // cross-account validation + notification are deferred to the Users read endpoint (Phase 5) —
  // resolution is itself account-scoped, so an out-of-account id can never resolve (research R6).
  mentions        String[] @default([])
  /// ── Feature 033 (roadmap 6.4): this message's identity ON ITS CHANNEL ─────────────────────────
  ///
  /// The `Message-ID` we were given for an inbound email, or the one we issued for an outbound reply.
  /// NULL for everything else — an agent's note, a widget message, every message written before 033.
  ///
  /// ⚠️ **Threading cannot be reconstructed after the fact.** A customer's reply quotes the identifier we
  /// put on the message weeks earlier; if we did not store it then, there is nothing to match and the
  /// thread splits with no way back. That is why inbound and outbound email had to be one feature rather
  /// than two, and it is why this column is written BEFORE the outbox row that produced it is deleted.
  external_id     String?
  created_at      DateTime @default(now())

  conversation Conversation  @relation(fields: [conversation_id], references: [id], onDelete: Cascade)
  attachments  MessageAttachment[]

  @@index([conversation_id, created_at]) // keyset thread paging
  @@index([account_id])
  /// ⭐ Feature 033: the same inbound email appears at most once (FR-032).
  ///
  /// ⚠️ Relies on Postgres treating NULLs as DISTINCT in a unique index, which is exactly the behaviour
  /// needed here: every non-email message has NULL and they must not collide with each other. That is a
  /// property of the database rather than of our code, so `tests/channels/constraints-033.spec.ts`
  /// asserts it directly — a future migration to a different engine, or to `NULLS NOT DISTINCT`, would
  /// otherwise turn "one copy per email" into "one message per conversation, silently".
  @@unique([account_id, external_id])
}

/// A message's link to an upload (feature 016, roadmap 4.9 / FR-014).
///
/// `upload_id` is a SOFT ref to `users.Upload.id` — no cross-service FK (Principle VIII). The
/// metadata behind it is fetched over gRPC per thread page and deliberately NOT denormalized into
/// chats_db: that keeps the PII-capable `display_name` in exactly one database.
///
/// THE PRIVATE-NOTE PROPERTY IS INHERITED, NOT RE-IMPLEMENTED. Attachments load through their
/// message via this relation, and the customer projection already excludes private messages AT THE
/// QUERY (feature 012). So a private note's attachments never enter the projection — provided
/// nothing ever fetches attachments by a separate query. `private-note-attachments.spec.ts` asserts
/// the outcome including that attachment and upload IDs are absent, not merely the bytes: the 012
/// lesson was that the id and the mentions leaked alongside the body (SEC-13 / SC-008).
model MessageAttachment {
  id         String   @id @default(uuid())
  account_id String
  message_id String
  upload_id  String // soft ref to users.Upload.id — resolved via gRPC, never joined
  position   Int      @default(0) // stable display order
  created_at DateTime @default(now())

  message Message @relation(fields: [message_id], references: [id], onDelete: Cascade)

  // An INDEX, not an application check: "have I attached this already?" followed by a write is a
  // race, and the 014 discipline is to let the database decide (FR-014).
  @@unique([message_id, upload_id])
  @@index([account_id])
  @@index([message_id, position])
}

/// A tag definition.
model Label {
  id         String   @id @default(uuid())
  account_id String
  name       String
  color      String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  conversations ConversationLabel[]

  @@unique([account_id, name])
}

/// Join edge: Conversation <-> Label (in-schema; no account_id — scoped via its parents).
model ConversationLabel {
  conversation_id String
  label_id        String

  conversation Conversation @relation(fields: [conversation_id], references: [id], onDelete: Cascade)
  label        Label        @relation(fields: [label_id], references: [id], onDelete: Cascade)

  @@id([conversation_id, label_id])
  @@index([label_id])
}

/// A one-click action bundle (engine built later — entity reserved).
model Macro {
  id         String   @id @default(uuid())
  account_id String
  name       String
  definition Json
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([account_id])
}

/// ⭐ W29 (R46): one row per macro APPLICATION — the raw fact under the operator's weekly usage
/// counter. Written inside the apply batch (all-or-nothing with the actions), read as a grouped
/// count over the last 7 days. Deliberately not a counter column: a column answers one window,
/// rows answer any window the operator asks for next.
model MacroApplication {
  id         String   @id @default(uuid())
  account_id String
  macro_id   String
  applied_at DateTime @default(now())

  @@index([account_id, macro_id, applied_at])
}

/// Reusable reply text an agent inserts while composing (feature 013, roadmap 4.5).
/// Account-shared library (not per-operator). TEXT ONLY — it never sends a message itself (FR-009).
model CannedResponse {
  id         String   @id @default(uuid())
  account_id String
  name       String
  body       String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([account_id, name])
  @@index([account_id])
}

/// Fair-rotation position for round-robin auto-assignment (feature 013, roadmap 4.4 / research R3).
/// `group_key` is opaque now (the caller supplies candidates); Users teams resolve it in Phase 5.
/// `cursor` = index of the LAST chosen candidate; -1 = fresh rotation.
model RoundRobinState {
  id         String   @id @default(uuid())
  account_id String
  group_key  String
  cursor     Int      @default(-1)
  updated_at DateTime @updatedAt

  @@unique([account_id, group_key])
  @@index([account_id])
}

/// A rule definition: trigger + conditions -> ordered actions (feature 014, roadmap 4.6).
/// Reserved by feature 006; given meaning here — the same path Macro took in 013.
///
/// `author_user_id` is the authority the rule acts with: its author's CURRENT effective permissions,
/// re-resolved on EVERY evaluation (FR-023 / research R5), so revoking a permission through Access
/// Management also stops that person's rules — no separate disable step, no frozen privilege.
/// ⚠️ `author_brands` was REMOVED by feature 020's cleanup (ADR 0038 §1). It captured "the author's
/// brand scope at authoring time" — a concept that no longer exists: one support department serves
/// every brand, so no author has a brand scope. It was written on every create, always empty because
/// nothing ever populated the caller's brand set, and **read by nothing**. A column that is always
/// empty and never read is an invitation to believe brand scope exists.
model Automation {
  id             String   @id @default(uuid())
  account_id     String
  name           String
  active         Boolean  @default(true)
  definition     Json
  author_user_id String // soft ref to an auth user — never joined (Principle VIII)
  /// Feature 024 (roadmap 5.3): the rule applies only to work routed to this group. Soft ref to
  /// `auth.Group.id`, never joined. NULL = unscoped, which is every rule that exists today.
  /// A rule whose group has been deleted matches NOTHING — see `Conversation.routed_group_id`.
  /// No index: the engine's hot lookup is already `[account_id, active]` and the scope is a
  /// post-filter over a small set. Stated so the omission reads as a decision (Principle VII).
  scope_group_id String?
  position       Int      @default(0) // evaluation order; ties broken by created_at
  revision       Int      @default(1) // bumped on every definition change, named by each run record
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  @@unique([account_id, name])
  @@index([account_id])
  @@index([account_id, active]) // the engine's hot lookup
}

/// One diagnostic entry per rule evaluation (feature 014, FR-007).
///
/// PII-FREE by construction: ids, an outcome and a short reason. A keyword rule records THAT it
/// matched, never what it matched on (FR-020 / SEC-26). This is NOT the 0019 audit store — the
/// durable audit log of sensitive actions is roadmap 4.8.
///
/// The unique on (automation_id, conversation_id, event_key) IS the at-most-once guarantee (FR-008 /
/// research R6): a violation means "this rule already handled this event" and is a successful no-op,
/// not an error. An application-level "have I done this?" check would be a race; a unique index is not.
///
/// Growth is unbounded until a retention policy exists (ADR 0015 defers retention; a trim job belongs
/// with the worker catalogue, 7.3). Stated deliberately rather than discovered in production.
model AutomationRun {
  id                  String   @id @default(uuid())
  account_id          String
  automation_id       String // soft ref within chats_db; a deleted rule keeps its history
  automation_revision Int
  conversation_id     String
  trigger             String
  event_key           String // deterministic per event occurrence (research R6)
  outcome             String // applied | not_matched | refused
  reason              String? // short, PII-free
  created_at          DateTime @default(now())

  @@unique([automation_id, conversation_id, event_key])
  @@index([account_id, automation_id, created_at])
  @@index([account_id, conversation_id])
}

/// The first-reply target (feature 014, roadmap 4.7, FR-010).
///
/// scope_* use the "*" SENTINEL rather than NULL: Postgres unique indexes treat NULLs as DISTINCT,
/// so NULL scoping would permit two account-level defaults and make "the target" ambiguous — the kind
/// of defect that surfaces as an unreproducible wrong deadline (research R7). Precedence, most
/// specific first: (brand, priority) -> (brand, *) -> (*, priority) -> (*, *).
model FirstReplySlaPolicy {
  id             String   @id @default(uuid())
  account_id     String
  target_minutes Int
  scope_priority String   @default("*")
  scope_brand_id String   @default("*")
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  @@unique([account_id, scope_priority, scope_brand_id])
  @@index([account_id])
}

/// Per-conversation first-reply measurement (feature 014, FR-011..FR-016). One row per conversation.
///
/// `target_minutes` + `deadline_at` are FROZEN at clock start: a later policy edit can neither
/// retro-breach nor un-breach a decided outcome (FR-016), AND the sweep predicate stays a plain
/// indexed comparison instead of a per-row policy resolution (research R8).
///
/// A PRIVATE note is inert here: it never stops the clock, never sets first_reply_at, and never
/// reaches a breach list (FR-012 — the SEC-13 invariant re-asserted on a new path).
model ConversationSlaState {
  id                  String    @id @default(uuid())
  account_id          String
  conversation_id     String
  started_at          DateTime // the first inbound player message
  target_minutes      Int
  deadline_at         DateTime
  outcome             String    @default("running") // running | met | breached
  first_reply_at      DateTime? // first PUBLIC staff reply
  first_reply_seconds Int?
  breach_announced_at DateTime? // stamped once — makes the breach fire exactly once, ever
  created_at          DateTime  @default(now())
  updated_at          DateTime  @updatedAt

  @@unique([conversation_id])
  @@index([account_id, outcome]) // the sla_outcome inbox filter
  // THE SWEEP PREDICATE — deliberately account-agnostic because the sweep is (research R2/R3).
  // A read index only; every write that follows the sweep goes through forAccount().
  @@index([outcome, deadline_at])
}

/// Audit trail entry (feature 015, roadmap 4.8 — ADR 0019; SEC-29/SEC-30; extended by 0032/SEC-AP3).
///
/// ⚠️ This model is INTENTIONALLY IDENTICAL in auth_db, users_db and chats_db. The table cannot be shared
/// (one database per service, Principle VIII) and the entry must be written inside the transaction of the
/// action it describes (spec Q3 — action and entry succeed together), so the entry lives beside its action.
/// `tests/data-model/audit-entry-identity.spec.ts` asserts the three definitions never drift apart.
///
/// APPEND-ONLY, structurally: no repository method and no controller updates or deletes a row, for any
/// role including the owner. Audit integrity is not a permission anyone can hold — the ABSENCE of the path
/// is the guarantee, and a structural test asserts it.
///
/// There is deliberately NO unique constraint. Feature 014 needed one because a scheduler could redeliver
/// an event; nothing redelivers a sensitive action. A retry is a NEW act by the operator and deserves its
/// own entry — two grant attempts, one failed, is exactly what a reviewer needs to see.
///
/// PII-free: `detail_json` is validated against a per-action-class key allow-list (libs/common/audit)
/// before the write, so a contact value or a message body is not expressible here. `target_ref` identifies,
/// never copies. Growth is unbounded until retention exists (ADR 0015 defers it; a trim job belongs with
/// the worker catalogue 7.3 — and must itself be audited as `audit.trim`).
model AuditEntry {
  id             String   @id @default(uuid())
  account_id     String
  actor_user_id  String // the REAL actor; soft ref to auth.User.id — never joined
  actor_kind     String   @default("user") // user | system
  actor_ref      String? // system actors only: which rule, under whose authority
  under_preview  Boolean  @default(false) // owner view-as marker; the previewed ROLE is never the actor
  action         String // from the closed catalogue — refused if unknown, never free text
  target_ref     String // user / rule / player / export id — identified, NEVER copied
  detail_json    Json? // PII-free, per-class allow-list validated
  created_at     DateTime @default(now())

  // The read surface orders by (created_at DESC, id DESC) so two entries in the same instant still page
  // deterministically — hence `id` in the ordering index.
  @@index([account_id, created_at, id])
  @@index([account_id, actor_user_id, created_at]) // "what did this user do"
  @@index([account_id, target_ref, created_at]) // "what happened to this record" / "who accessed this player"
}

/// One data export (feature 017, roadmap 4.10 — SEC-21/SEC-22/SEC-27).
///
/// This row — not the stored artefact — is what authorization, status and expiry are decided against.
/// The `Upload` row in users_db holds only bytes; going through this record is what adds OWNER-only
/// access (FR-011), because `Upload` is account-scoped and this feature's rule is narrower than that.
///
/// ── What is deliberately NOT here ────────────────────────────────────────────────────────────────
/// • No cached permission set. The row names `requested_by` and nothing about what that user may do:
///   the producer RE-RESOLVES their current permissions at production time (research R15). A stored
///   permission set would be a stale second copy of the RBAC source of truth — exactly what feature
///   014 refused for automation authors, and it would mean a revoked permission still produced a file.
/// • No `deleted_at`. A purged artefact leaves `upload_id` null and `status = expired`; the record of
///   who exported what survives in the audit trail, which is append-only by construction.
/// • No cancel/edit path. Nothing mutates a row after creation except the system transitions.
model ExportJob {
  id       String @id @default(uuid())
  /// Tenant key (Principle I). Enrolled in SCOPED_MODELS, reached only via forAccount, fail-closed.
  account_id String
  /// From the closed catalogue (libs/common/src/exports/scopes.ts) — never free text.
  scope    String
  /// `csv` in v1. Stored because the audit entry reports it and a future second format must not make
  /// old rows ambiguous.
  format   String
  /// Soft ref to auth.User.id — never joined (Principle VIII). THE OWNER: only this user may download.
  requested_by String
  /// The filter set, in the existing list vocabulary (FR-027). Stored so the status view can show what
  /// was asked and the export is reproducible.
  /// ⚠️ NEVER audited and NEVER logged — a filter value can be a search term carrying PII (SEC-26), and
  /// the audit detail allow-list makes it structurally inexpressible (FR-019).
  filters_json Json?
  /// queued | running | ready | failed | expired
  status   String @default("queued")
  /// Set at completion. `row_count` is the number the audit entry carries.
  row_count Int?
  byte_size Int?
  /// Soft ref to users.Upload.id. Null until `ready`, and null AGAIN after the purge.
  upload_id String?
  /// A short CODE from the closed list (never a raw error, never a row value).
  failure_reason String?
  /// Computed at creation from the scope's TTL — the same value written to Upload.expires_at (R7), so
  /// each service can answer its own question without a cross-service call.
  expires_at DateTime
  /// Set when a tick claims the row; also the stale-claim detector.
  claimed_at DateTime?
  created_at DateTime @default(now())
  completed_at DateTime?

  /// Keyset order for the caller's own list; `id` breaks same-instant ties (the 015 lesson).
  @@index([account_id, created_at, id])
  /// The quota count (research R11): this requester's rows in the trailing window.
  @@index([account_id, requested_by, created_at])
  /// The RunDueExports claim predicate + stale-claim recovery. Not account-scoped on purpose: it serves
  /// the system-actor sweep, which is id-only and fenced exactly as 014's SLA sweep is.
  @@index([status, claimed_at])
  /// The ExpireDueExports predicate, same reasoning.
  @@index([status, expires_at])
}

/// One durable statement that something changed (feature 023, roadmap 4.8a — ADR 0046).
///
/// ── Why this exists ──────────────────────────────────────────────────────────────────────────────
/// Every metric the support team tracks — backlog, reopened %, one-touch %, first reply time, per-agent
/// load — is derived from TRANSITIONS, not from a conversation's current row. Store only current state
/// and those numbers are permanently unavailable for the past; no later migration can invent them.
///
/// ── ⚠️ This is NOT the audit trail, and it is NOT a `DomainEvent` ────────────────────────────────
/// `AuditEntry` (feature 015) is STRICT: if its write fails, the action is refused, and PII is
/// structurally inexpressible there. This table is high-volume (~10-30k/day at the operator's traffic)
/// and exists to reconstruct history.
/// `DomainEvent` (feature 014, `src/events/`) is the opposite of both: in-process, synchronous,
/// deliberately LOSSY (a throwing subscriber is swallowed), and it legitimately carries message text in
/// memory. The three must never converge — `tests/transitions/no-dispatcher-crossover.spec.ts` keeps
/// them apart, because merging this with `DomainEvent` would land customer message bodies in an
/// append-only store.
///
/// ── The two halves of the guarantee (ADR 0046 §4a) ───────────────────────────────────────────────
/// RECORDING is atomic: the row is written inside the transaction of the change it describes, so a
/// rolled-back change leaves nothing and a recorded transition always happened.
/// DELIVERY is asynchronous and best-effort — and today there is no consumer at all, so nothing on the
/// customer-facing path may block on one. A later aggregator (roadmap 11.0) reads forward by watermark
/// over (account_id, occurred_at, id); that is why no `delivered_at` column exists.
///
/// ── Append-only, and never trimmed ───────────────────────────────────────────────────────────────
/// No update path, no delete path, in any service (asserted by tests/transitions/append-only.spec.ts).
/// Retention is CONFIGURATION only and no cleanup job is built: the windows are provisional pending the
/// operator's answer on access-record retention and SEC-25, and deleting on an unconfirmed number is
/// exactly what feature 018 refused when it reverted `record.open`.
model ConversationTransition {
  id         String @id @default(uuid())
  account_id String

  /// From the closed catalogue in @crm/common — refused at write time if unknown, never free text.
  type String

  /// When it HAPPENED (millisecond precision, UTC) — the ordering key. Distinct from created_at, which
  /// is when the row was written; they differ only under retry.
  occurred_at DateTime

  /// user | system | integration. Never blank for a system act: a timer or a rule names itself.
  actor_kind String
  /// The user id, or the rule/job that acted. Soft ref — never joined across a service boundary.
  actor_ref  String?

  /// What the transition is about. `conversation` today; later writers widen it.
  subject_kind String
  subject_id   String

  /// Minimal and TYPED — ids and enums only, validated against the per-type allow-list in
  /// @crm/common. A message body, a contact value, a file name and the SUBJECT TEXT are all
  /// inexpressible here, not merely discouraged (Principle IV / SEC-26).
  payload_json Json?

  /// The reporting dimensions AS THEY WERE at this instant (brand, channel, assignee, submitter role).
  /// A SNAPSHOT, not references: renaming a brand must not rewrite history. Dimensions that do not
  /// exist yet (group → 5.3, form → 4.15) are ABSENT, not null — a null would claim the dimension
  /// existed and was empty.
  dims_json Json

  /// Ties this to the audit entry produced by the same act, without either becoming the other's
  /// source of truth.
  correlation_id String

  created_at DateTime @default(now())

  /// Ordering + the watermark a later aggregator reads forward on. `id` breaks same-instant ties, so
  /// two transitions in the same millisecond still page deterministically (the 015 lesson).
  @@index([account_id, occurred_at, id])
  /// "Reconstruct this conversation's life" — SC-001.
  @@index([account_id, subject_id, occurred_at])
  /// "Every status change in this range" — SC-002.
  @@index([account_id, type, occurred_at])
}

/// ⭐ One operator READ one conversation — the fact under the agent rail (roadmap 4.19, MVP block W5).
///
/// ── Why a fact table and not a list ──────────────────────────────────────────────────────────────
/// The operator's rule for his rail: a ticket enters it when it was ASSIGNED to him and he OPENED it,
/// and leaves only when the work is finished — closing the window must change nothing. A stored list
/// would need add/remove bookkeeping that can rot (the same reasoning that kept time out of
/// `priority_rank`). So the rail is a VIEW over three durable facts — `assignee_operator_id = me`
/// (already on Conversation) ∧ a row HERE (he opened it) ∧ a non-terminal status category — and there
/// is no state machine to break: reassignment away removes it by predicate, solving it removes it by
/// predicate, and nothing is ever deleted.
///
/// ── What the columns mean ────────────────────────────────────────────────────────────────────────
/// `first_opened_at` is written once and never updated — "he opened it" is a one-time fact.
/// `last_read_at` advances on every read; it is the half 9.12's unread badge will stand on
/// (unread = a message newer than this), stored now because both facts arrive on the same event and
/// splitting them into two tables would mean two upserts on every detail open.
///
/// ⚠️ `operator_id` is a soft ref to users.Operator.id, resolved from the CALLER's validated context
/// (never a parameter — an agent must not be able to stamp "opened" as somebody else). NULL never
/// appears: a reader without an operator profile simply writes no row.
model ConversationReadMark {
  id              String   @id @default(uuid())
  account_id      String
  conversation_id String
  operator_id     String
  first_opened_at DateTime @default(now())
  last_read_at    DateTime @default(now())

  /// The relation exists for ONE query: the rail's `read_marks: { some: { operator_id } }` EXISTS
  /// predicate. Cascade mirrors Message's: a mark without its conversation is meaningless.
  conversation Conversation @relation(fields: [conversation_id], references: [id], onDelete: Cascade)

  /// One mark per reader per conversation — the upsert key, and what makes a re-read idempotent.
  @@unique([account_id, conversation_id, operator_id])
  /// The rail's own lookup: "which conversations has THIS operator opened".
  @@index([account_id, operator_id])
}

// ── ⭐ Feature 037 (roadmap 4.15 — W30): custom ticket fields, forms & option sets ─────────────────
//
// The two-level discipline (statuses/channels): the field TYPE vocabulary is code
// (`libs/common/src/fields/field-types.ts`, four closed values); everything below is per-account
// CONFIGURATION — the operator's ~65 captured Zendesk fields become rows here, never code, and
// `tests/fields/no-field-key-branch.spec.ts` scans that nothing branches on a field or form key.
//
// ⚠️ These are TICKET fields on `Conversation` — never `Player.custom_attributes` (the customer's
// tiered portfolio data in users_db, "the roadmap-4.15 failure shape").
//
// ⚠️ ARCHIVE OVER DELETE everywhere (criterion ① — values already live on conversations): fields
// and forms carry `active`; option values deactivate once used; the only hard delete is an option
// set no field references.

/// One custom ticket field definition. `key` is the per-account authoring identity (the wire name,
/// the value row's target, the thing the admin edits BY). `type` is validated against the closed
/// catalogue in the service — never an enum here, so adding a type is a catalogue row, not a
/// migration.
model FieldDefinition {
  id            String   @id @default(uuid())
  account_id    String
  key           String
  label         String
  type          String
  /// Gates the transition into a solved-category status (D4: required-to-solve), never editing.
  required      Boolean  @default(false)
  /// Withheld — definition AND value — from callers without `crm.conversation.restricted_field.view`.
  /// ⚠️ At seed time NO field is restricted (Q15: nothing limited by default); this is mechanism.
  restricted    Boolean  @default(false)
  /// Present ⟺ `type = 'dropdown'` — a biconditional the SERVICE enforces (Prisma cannot express it).
  option_set_id String?
  /// Empty = applicable to all brands. Opaque ids from brands_db (soft refs — Principle VIII, no
  /// cross-service FK), data per Principle VI: no code branches on a brand.
  brand_ids     String[] @default([])
  active        Boolean  @default(true)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  option_set   OptionSet?               @relation(fields: [option_set_id], references: [id])
  form_entries FormField[]
  values       ConversationFieldValue[]

  @@unique([account_id, key])
  @@index([account_id, active])
  /// The "may this set be deleted / this value deactivated" checks walk from the set to its fields.
  @@index([option_set_id])
}

/// A reusable, ordered value list for dropdown fields. Deletable ONLY while no field references it
/// (the service refuses with the field's name — 409, worded).
model OptionSet {
  id         String   @id @default(uuid())
  account_id String
  name       String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  values OptionValue[]
  fields FieldDefinition[]

  @@unique([account_id, name])
  @@index([account_id])
}

/// One value of one set. `active = false` is the fate of a value conversations already hold: it
/// keeps rendering where stored and is refused for NEW writes — history is never rewritten by an
/// authoring act. Cascade with the set: an unreferenced set's hard delete takes its values along.
/// ⚠️ `account_id` directly on the row, not only via the set: Principle I's guard exempts only pure
/// join edges (composite @@id), and a child reachable through one query hop is exactly the row a
/// future direct read would forget to scope.
model OptionValue {
  id            String  @id @default(uuid())
  account_id    String
  option_set_id String
  value         String
  order         Int
  active        Boolean @default(true)

  option_set OptionSet @relation(fields: [option_set_id], references: [id], onDelete: Cascade)

  @@unique([option_set_id, value])
  @@index([option_set_id, order])
  @@index([account_id])
}

/// A named, ordered composition of fields — AND the analytics anchor: `category` is the topic a
/// human's form choice files the conversation under (writes the reserved `Conversation.category`
/// with the U9 lock; NULL = a neutral form like Default). The capture's 12 forms seed this table.
model Form {
  id         String   @id @default(uuid())
  account_id String
  key        String
  name       String
  category   String?
  active     Boolean  @default(true)
  order      Int      @default(0)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  entries       FormField[]
  conversations Conversation[]

  @@unique([account_id, key])
  @@unique([account_id, name])
  @@index([account_id, active, order])
}

/// One field's place on one form. The optional condition pair is the capture's L1→L2→L3 cascade as
/// data: the entry renders (and accepts writes) only while the parent dropdown holds exactly
/// `condition_value` — both columns set together or neither (service-enforced).
///
/// ⚠️ `is_subcategory_source`: at most ONE per form. Prisma cannot express a conditional unique, so
/// the shipped migration adds a PARTIAL UNIQUE INDEX (`WHERE is_subcategory_source`) — the
/// feature-026 precedent; a structural test reads the migration SQL rather than this comment.
model FormField {
  id                    String  @id @default(uuid())
  /// Principle I, the OptionValue reasoning: not a pure join edge (it carries payload and its own
  /// id), so it carries the scope column itself.
  account_id            String
  form_id               String
  field_id              String
  order                 Int
  condition_field_id    String?
  condition_value       String?
  is_subcategory_source Boolean @default(false)

  form  Form            @relation(fields: [form_id], references: [id], onDelete: Cascade)
  field FieldDefinition @relation(fields: [field_id], references: [id])

  @@unique([form_id, field_id])
  @@index([form_id, order])
  @@index([account_id])
}

/// The value one conversation holds for one field — one row per pair (the upsert key below), which
/// is what makes a re-write idempotent and a partial write impossible (the OperatorUiPreference
/// argument: a blob defers modelling; rows validate per key). `value` stores the TEXT form for
/// every type; the validator, not the column, refuses a non-number in a numeric field.
///
/// ⚠️ The sub-category source's value is NOT here — it lives in `Conversation.sub_category` (single
/// store, D2). ⚠️ `account_id` directly on the row (Principle I: every tenant-owned table carries
/// it), not only via the conversation join.
model ConversationFieldValue {
  id              String   @id @default(uuid())
  account_id      String
  conversation_id String
  field_id        String
  value           String
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  conversation Conversation    @relation(fields: [conversation_id], references: [id], onDelete: Cascade)
  field        FieldDefinition @relation(fields: [field_id], references: [id])

  @@unique([conversation_id, field_id])
  /// The "is this option value in use" check walks from the field to its values.
  @@index([field_id])
  @@index([account_id])
}
