// Brands service schema — brands_db (feature 006, roadmap 2.2).
// DB-per-service (ADR 0029): targets ONLY brands_db via the service's own DATABASE_URL +
// role. Per-service generated client path (research R1). Owns brand identity + the ADR 0003
// brand-access seam (enforcement is a later feature). Brands are DATA, never hardcoded
// identity (Principle VI, white-label).
// Model surface reviewed in specs/006-contracts-data-model/data-model.md (Brands section).

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// A white-label brand as a tenant-scope row — never hardcoded identity (Principle VI).
model Brand {
  id         String   @id @default(uuid())
  account_id String
  name       String
  slug       String
  active     Boolean  @default(true)
  /// Feature 020 — the visual identity. A brand is IDENTIFICATION, not a permission (ADR 0038 §1):
  /// an agent sees at a glance which brand a ticket came from, inside one interface. Values are data,
  /// never hardcoded (Principle VI, white-label), and this is NOT the install's own theming — that is
  /// the token layer (0028), a different thing that 0038 §4 separates.
  icon       String   @default("")
  accent     String   @default("")
  settings   Json?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([account_id, slug])
  @@index([account_id])
}

/// Which operators may read/answer which brand (ADR 0003 seam; ENFORCEMENT is a later feature).
/// operator_id is a soft ref to users.Operator.id — no cross-service FK (resolved via gRPC).
/// ⚠️ `BrandAccessRule` (which operator may read/answer which brand) was REMOVED by feature 020's
/// cleanup (ADR 0038 §1). The operation has ONE support department: the same people handle every
/// brand at the same time, so a per-operator brand permission is not a thing anyone wants.
///
/// It was also never used — nothing wrote a rule, nothing read one, and the RPC meant to check them
/// was served by nothing. Removed rather than kept "in case": this table is exactly where a future
/// engineer would add the restrictions the operation does not want, and its presence is an argument
/// that they belong somewhere.
