# .env.example — local development configuration (spec 003-local-infra).
#
# Copy to `.env` (git-ignored) and fill REAL values. Every value below set to `CHANGE_ME`
# is a placeholder: services and the Postgres init REFUSE TO START until you replace it
# (SEC-6 / US2). Ports and NODE_ENV are real defaults, not secrets. NEVER commit `.env`.

# --- Runtime ---
NODE_ENV=development

# --- Postgres (one engine; a DB + isolated role per data-owning service) ---
# Superuser (used only by the container + init script to create per-service roles/DBs).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME
# Per-service role passwords (init script creates auth_user/users_user/… with these).
AUTH_DB_PASSWORD=CHANGE_ME
USERS_DB_PASSWORD=CHANGE_ME
CHATS_DB_PASSWORD=CHANGE_ME
BRANDS_DB_PASSWORD=CHANGE_ME

# Per-service DATABASE_URL — compose builds these per container from the passwords above.
# Shown here for reference / running a single service outside compose (fill the password):
#   auth  : postgresql://auth_user:<AUTH_DB_PASSWORD>@localhost:5432/auth_db
#   users : postgresql://users_user:<USERS_DB_PASSWORD>@localhost:5432/users_db
#   chats : postgresql://chats_user:<CHATS_DB_PASSWORD>@localhost:5432/chats_db
#   brands: postgresql://brands_user:<BRANDS_DB_PASSWORD>@localhost:5432/brands_db

# --- Redis (shared cache/queue; used by worker via BullMQ and by the gateway) ---
REDIS_URL=redis://localhost:6379

# --- Gateway (single host-exposed ingress: REST + WebSocket) ---
GATEWAY_PORT=3000
# Where the WEB app proxies its /api/* prefix (feature 019). The browser never calls the gateway
# cross-origin: the gateway enables no CORS and its session cookie is sameSite=lax, so the web app
# rewrites /api/* to this origin on its own host. Keep it internal — it is a server-side destination.
GATEWAY_ORIGIN=http://localhost:3000
# gRPC dial targets (compose sets these to service DNS names; localhost for bare-metal run).
AUTH_GRPC_TARGET=localhost:50051
USERS_GRPC_TARGET=localhost:50052
CHATS_GRPC_TARGET=localhost:50053
BRANDS_GRPC_TARGET=localhost:50054
WORKER_GRPC_TARGET=localhost:50055

# --- Per-backend-service gRPC bind address ---
# Each backend service reads GRPC_URL as its own bind address. Compose sets this per
# container (e.g. auth => 0.0.0.0:50051). For a single bare-metal service run, export the
# matching one, e.g.:  GRPC_URL=0.0.0.0:50051
GRPC_URL=0.0.0.0:50051

# --- Auth engine & sessions (feature 009) ---
# JWT_SECRET signs the short-lived access token and is verified LOCALLY at the gateway, so
# BOTH the auth service and the gateway read the SAME value. It is a SECRET → refuse-to-start
# until replaced (SEC-6). Use a long random string (e.g. `openssl rand -base64 48`).
JWT_SECRET=CHANGE_ME
# Cookie Secure flag — keep `true` in production (SEC-7/SEC-11); set `false` ONLY for local
# plain-HTTP dev where cookies must flow over http://localhost.
COOKIE_SECURE=true
# Dev-only login-code sink: when set to a file path, the in-memory dev EmailPort also appends
# each delivered one-time code to that file (one JSON line) so a LOCAL/DEV flow can read it
# without real SMTP. Leave UNSET in production — the code is a secret and must not hit disk.
# LOGIN_CODE_DEV_SINK=/tmp/login-codes.log
# Tunables (safe defaults applied if unset; seconds unless noted). Uncomment to override:
#   ACCESS_TTL=900          # access token lifetime (15 min)
#   SESSION_TTL=86400       # default session/refresh lifetime (1 day)
#   REMEMBER_TTL=604800     # "remember me" session lifetime (7 days)
#   CODE_TTL=600            # one-time login code lifetime (10 min)
#   CODE_LENGTH=6           # one-time code length
#   CODE_MAX_ATTEMPTS=5     # wrong-code attempts before a challenge dies
#   LOCKOUT_THRESHOLD=5     # consecutive failed logins before lockout (SEC-14)
#   LOCKOUT_WINDOW=900      # lockout auto-release window (15 min)
#   ARGON2_MEMORY_COST=19456
#   ARGON2_TIME_COST=2

# --- Object store for uploads (feature 016, roadmap 4.9 — MinIO local/test, managed bucket in prod) ---
# Read by the USERS service ONLY. It is the single holder of these credentials (research R2):
# the gateway proxies bytes and declares nothing here — a second service declaring S3_* fails
# tests/uploads/single-ingest-path.spec.ts. Users refuses to start on any missing/placeholder
# value (SEC-6); the error names the KEY, never the value.
# The bucket MUST be private. compose's one-shot `minio-init` creates it and sets `anonymous none`.
S3_ENDPOINT=http://localhost:9000   # compose sets http://minio:9000 inside the network
S3_REGION=us-east-1                 # MinIO ignores it; the AWS SDK requires one
S3_BUCKET=CHANGE_ME
S3_ACCESS_KEY_ID=CHANGE_ME          # also the MinIO root user in compose
S3_SECRET_ACCESS_KEY=CHANGE_ME      # SECRET → also the MinIO root password in compose
S3_FORCE_PATH_STYLE=true            # required for MinIO; `false` for a real S3 endpoint

# --- Contact-match salt (feature 020 — users service only) ---
# Cross-brand player linking compares a HASH of a normalised email/phone, never the value itself.
# The salt is what keeps that hash from being reversible: an unsalted hash of an email is a
# dictionary lookup away from the address. Min 32 chars, and the service REFUSES TO START without
# it — a missing salt has no symptom, so it cannot be allowed to default.
# Generate one per deployment and never reuse it across environments:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CONTACT_HASH_SALT=replace-me-with-32-plus-random-characters

# --- Web (Next.js dev server; runs via `npm run dev:web`, not containerised until Phase 8) ---
WEB_PORT=3001

# --- GR8 Integrations API (Worker connector; roadmap 7.4 — see cowork/reference/gr8/) ---
# Base URL, API key and brand are ISSUED BY THE GR8 TEAM on a config request.
# GR8_API_KEY is a SECRET — never commit a real value, never write it into docs/wiki.
# (Pointer only: wiki/references/credentials-and-accounts.md.) Worker refuses to start
# without these once the connector is built.
GR8_API_BASE_URL=CHANGE_ME          # e.g. https://<issued-by-gr8>/api/v1
GR8_API_KEY=CHANGE_ME               # SECRET → X-Api-Key header
GR8_BRAND=CHANGE_ME                 # X-Brand header (brand code issued by GR8)

# GR8 is FOUR access sets with THREE auth schemes (second GR8 answer, 2026-07-28).
# The keys above are the Support Hub (Player 360) set. The three below are the others —
# placeholders only, filled when AM/PM issue them. See cowork/reference/gr8/ ("Access & gateways")
# and roadmap 7.4a-7.4d. NEVER commit real values; NEVER paste them into docs/wiki/tickets.

# Identity / Wallet — Service-to-Service gateway, Service Account auth (roadmap 7.4b).
# NOT the client-facing /v0/identity/* path (that one is for browsers, X-Api-Key + X-ClientId).
# Credentials are created and per-endpoint permissions configured BY GR8's AM — request least
# privilege, rotate on a schedule (security/findings.md SEC-GR1). Writes go here (SEC-GR2 / 7.7).
GR8_S2S_BASE_URL=CHANGE_ME          # S2S gateway domain (issued with the credentials)
GR8_S2S_CLIENT_ID=CHANGE_ME         # Service Account identity
GR8_S2S_CLIENT_SECRET=CHANGE_ME     # SECRET → Service Account credential (highest-privilege external secret)

# CRM API — base path is a CUSTOM DOMAIN issued by AM/PM (roadmap 7.4c).
GR8_CRM_BASE_URL=CHANGE_ME          # custom domain, issued by AM/PM
GR8_CRM_TOKEN=CHANGE_ME             # SECRET → Authorization header
GR8_CRM_OPERATOR_ID=CHANGE_ME       # X-Operator-Id header (value from AM/PM); X-Brand reuses GR8_BRAND

# Data API (GraphQL) — credentials AND per-object permissions come with an Access Ticket (7.4d).
# Hard 180-day history limit; older data = Athena or our own snapshots (undecided — roadmap 7.8).
GR8_DWH_GRAPHQL_URL=CHANGE_ME       # prod https://api.dwh-prod.cenv-eu.tech/v2/graphql
                                    # stage https://api.dwh-stage.cenv-eu.tech/v2/graphql
GR8_DWH_TOKEN=CHANGE_ME             # SECRET → issued with the Access Ticket

# ── Feature 023 (roadmap 4.8a + 4.18) — the transition stream and the conversation title ─────────
#
# Required by the chats service's refuse-to-start guard (SEC-6). Compose supplies the values below as
# fallbacks, so overriding here is only needed to change them.
#
# 🅿 PROVISIONAL — revised by the operator's answer on access-record retention (Q1) and by SEC-25.
# Nothing reads them yet and no deletion job exists: the windows are declared so that the job which
# eventually trims history reads a confirmed value instead of inventing one.
TRANSITION_RETENTION_DAYS=365
TRANSITION_RESTRICTED_RETENTION_DAYS=90
# How long the title-derivation window stays open when neither the customer's 3rd message nor a staff
# reply closes it first. Lower it on a test box to watch the sweep work.
SUBJECT_WINDOW_TIMEOUT_MINUTES=10
