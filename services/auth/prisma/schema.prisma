// Auth service schema — auth_db (feature 006, roadmap 2.2).
// DB-per-service (ADR 0029): this schema targets ONLY auth_db via the service's own
// DATABASE_URL + role (deploy/local/postgres/init). Its client generates to a per-service
// path so four Prisma clients coexist in one monorepo without collision (research R1).
// Model surface reviewed in specs/006-contracts-data-model/data-model.md (Auth section).
// Enforcement (isolation middleware, RBAC, MFA) is Phase 3 — here the entities + seams exist.

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// An authenticatable staff account (identity for sign-in).
model User {
  id           String   @id @default(uuid())
  account_id   String // tenant seam (ADR 0003) — indexed below.
  email        String
  display_name String?
  status       String   @default("active") // active | disabled | pending | invited (010)
  mfa_enabled  Boolean  @default(false) // enforcement (no bypass) is Phase 3 — SEC-2.
  // Lockout state (feature 009, SEC-14). failed_login_count is consecutive failures, reset
  // to 0 on any successful login; when locked_until is set and in the future, login is
  // refused with a generic "try later" (no enumeration).
  failed_login_count Int       @default(0)
  locked_until       DateTime?
  created_at         DateTime  @default(now())
  updated_at         DateTime  @updatedAt

  credentials Credential[]
  roles       UserRole[]
  loginCodes  LoginCode[]
  refreshTokens RefreshToken[]
  permissionSet     UserPermissionSet? // feature 011 — copy-on-write personalization state
  permissionEntries UserPermissionEntry[] // feature 011 — standalone snapshot rows

  @@unique([account_id, email])
  @@index([account_id])
}

/// Secret material / login method bound to a User. SHAPE ONLY — no plaintext (Principle IV).
/// account_id is denormalized here (like chats.Message) so isolation attaches uniformly.
model Credential {
  id              String    @id @default(uuid())
  account_id      String
  user_id         String
  type            String // password | magic-link | ...
  secret_hash     String? // argon2/bcrypt hash; null until Phase 3 sets it.
  last_rotated_at DateTime?
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([account_id])
  @@index([user_id])
}

/// A named permission grouping. The concrete 3.6 role set + overrides land in Phase 3.
model Role {
  id         String   @id @default(uuid())
  account_id String
  key        String // agent | admin | super_admin | am | shift_am | vip_support | teamlead
  label      String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  users           UserRole[]
  rolePermissions RolePermission[] // feature 011 — this role's default (template) permission set

  @@unique([account_id, key])
  @@index([account_id])
}

/// Join edge: User <-> Role (in-schema; no account_id — scoped via its parents).
model UserRole {
  user_id String
  role_id String

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)
  role Role @relation(fields: [role_id], references: [id], onDelete: Cascade)

  @@id([user_id, role_id])
  @@index([role_id])
}

/// One-time email code for the 2-step login (feature 009). The code itself is NEVER stored
/// or logged in clear — only its argon2id hash (Principle IV). At most one *active* challenge
/// per user: a new Login supersedes any prior unconsumed one. account_id is the tenant seam.
model LoginCode {
  id           String    @id @default(uuid())
  account_id   String
  user_id      String
  challenge_id String    @unique // opaque handle returned by Login; presented to VerifyLoginCode.
  code_hash    String // argon2id hash of the N-char code.
  purpose      String    @default("login_2fa") // login_2fa | activation | registration (010); recovery reserved.
  expires_at   DateTime // now + CODE_TTL; expired codes refused.
  attempts     Int       @default(0) // wrong entries; at CODE_MAX_ATTEMPTS the challenge is dead.
  consumed_at  DateTime? // set on success → single-use.
  created_at   DateTime  @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([account_id])
  @@index([expires_at])
}

/// Rotating session token (feature 009). The opaque refresh secret is delivered only in the
/// httpOnly cookie; at rest we keep an argon2id hash. Rotated on each use (old one revoked);
/// reuse of a revoked/rotated token is refused (theft detection). account_id is the tenant seam.
model RefreshToken {
  id           String    @id @default(uuid())
  account_id   String
  user_id      String
  token_hash   String // argon2id hash of the refresh secret.
  remember_me  Boolean   @default(false) // selects lifetime class (~1d vs ~7d).
  expires_at   DateTime // fixed at issue (no sliding renewal).
  rotated_from String? // prior token id in the rotation chain (reuse detection).
  revoked_at   DateTime? // set on logout, rotation, or reuse detection.
  created_at   DateTime  @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([account_id])
  @@index([token_hash])
  @@index([expires_at])
}

/// Server-side super-admin authorization list (feature 010, roadmap 3.8). Edited ONLY out-of-band
/// (seed / migration / ops SQL) — there is NO app write path (FR-001). Each row binds an email to
/// the account it onboards a super-admin into. "Spent" once an active User exists for the email.
/// The activation lookup-by-email is a pre-account bootstrap read via the RAW client (like 009 login).
model SuperadminWhitelist {
  id         String   @id @default(uuid())
  account_id String // the account this entry onboards a super-admin INTO.
  email      String   @unique
  note       String? // optional ops note (never a secret).
  created_at DateTime @default(now())

  @@index([account_id])
}

/// Single-use, expiring invitation (feature 010, roadmap 3.9/3.10). The token secret is delivered
/// only in the emailed link; at rest we keep an argon2id hash. Registration email MUST match `email`.
/// role_key is never "super_admin" (super-admins originate only from the whitelist). Lookup-by-token
/// at registration is a pre-account bootstrap read via the RAW client.
model Invitation {
  id          String    @id @default(uuid()) // public half of "<id>.<secret>".
  account_id  String // the account the invitee joins.
  email       String // invited address; registration email must match exactly.
  role_key    String // granted role on completion (never "super_admin").
  invited_by  String // user_id of the issuing admin/super-admin (audit).
  token_hash  String // argon2id hash of the invite secret.
  expires_at  DateTime // now + INVITE_TTL; expired invites refused (SEC-5).
  consumed_at DateTime? // set when registration completes → single-use.
  created_at  DateTime  @default(now())

  @@index([account_id])
  @@index([email])
  @@index([expires_at])
}

// --- Feature 011: RBAC (roadmap 3.3/3.6/3.7; ADR 0004 filled by 0034) ---

/// The extensible, versioned permission registry (FR-001). A permission is identified by
/// (account_id, category, key); `introduced_version` records the catalogue version it was added at.
/// A newly-added permission is in NO role default → OFF for everyone until granted (R-2 corollary).
model Permission {
  id                 String   @id @default(uuid())
  account_id         String
  category           String // logical group: crm | analytics | users | reports | platform | …
  key                String // e.g. contact.read_pii | role.manage | settings.manage
  label              String? // human label (never a brand identity — Principle VI).
  introduced_version Int      @default(1)
  created_at         DateTime @default(now())

  rolePermissions RolePermission[]
  userEntries     UserPermissionEntry[]

  @@unique([account_id, category, key])
  @@index([account_id])
}

/// Role → permission (the role's DEFAULT/template set = its matrix row). No account_id — scoped
/// via its Role parent. Editing these rows is the "whole-role" management action + reset target.
model RolePermission {
  role_id       String
  permission_id String

  role       Role       @relation(fields: [role_id], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permission_id], references: [id], onDelete: Cascade)

  @@id([role_id, permission_id])
  @@index([permission_id])
}

/// Per-user personalization state (copy-on-write, R-2). Absent row / mode="inherited" → the user
/// live-inherits the role default. mode="standalone" → effective = the user's UserPermissionEntry
/// snapshot (role-template changes no longer propagate until reset). account_id is the tenant seam.
model UserPermissionSet {
  user_id          String   @id
  account_id       String
  mode             String   @default("inherited") // inherited | standalone
  snapshot_role_id String? // the role snapshotted at personalization time (audit/debug).
  updated_at       DateTime @updatedAt

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([account_id])
}

/// A standalone snapshot row — present ONLY when the user's set is "standalone". The materialized
/// effective grant. No account_id — scoped via its User/Permission parents.
model UserPermissionEntry {
  user_id       String
  permission_id String
  granted       Boolean @default(true)

  user       User       @relation(fields: [user_id], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permission_id], references: [id], onDelete: Cascade)

  @@id([user_id, permission_id])
  @@index([user_id])
}

/// Audit trail entry (feature 015, roadmap 4.8 — ADR 0019; SEC-29/SEC-30; extended by 0032/SEC-AP3).
///
/// ⚠️ This model is INTENTIONALLY IDENTICAL in auth_db, users_db and chats_db. The table cannot be shared
/// (one database per service, Principle VIII) and the entry must be written inside the transaction of the
/// action it describes (spec Q3 — action and entry succeed together), so the entry lives beside its action.
/// `tests/data-model/audit-entry-identity.spec.ts` asserts the three definitions never drift apart.
///
/// APPEND-ONLY, structurally: no repository method and no controller updates or deletes a row, for any
/// role including the owner. Audit integrity is not a permission anyone can hold — the ABSENCE of the path
/// is the guarantee, and a structural test asserts it.
///
/// There is deliberately NO unique constraint. Feature 014 needed one because a scheduler could redeliver
/// an event; nothing redelivers a sensitive action. A retry is a NEW act by the operator and deserves its
/// own entry — two grant attempts, one failed, is exactly what a reviewer needs to see.
///
/// PII-free: `detail_json` is validated against a per-action-class key allow-list (libs/common/audit)
/// before the write, so a contact value or a message body is not expressible here. `target_ref` identifies,
/// never copies. Growth is unbounded until retention exists (ADR 0015 defers it; a trim job belongs with
/// the worker catalogue 7.3 — and must itself be audited as `audit.trim`).
model AuditEntry {
  id             String   @id @default(uuid())
  account_id     String
  actor_user_id  String // the REAL actor; soft ref to auth.User.id — never joined
  actor_kind     String   @default("user") // user | system
  actor_ref      String? // system actors only: which rule, under whose authority
  under_preview  Boolean  @default(false) // owner view-as marker; the previewed ROLE is never the actor
  action         String // from the closed catalogue — refused if unknown, never free text
  target_ref     String // user / rule / player / export id — identified, NEVER copied
  detail_json    Json? // PII-free, per-class allow-list validated
  created_at     DateTime @default(now())

  // The read surface orders by (created_at DESC, id DESC) so two entries in the same instant still page
  // deterministically — hence `id` in the ordering index.
  @@index([account_id, created_at, id])
  @@index([account_id, actor_user_id, created_at]) // "what did this user do"
  @@index([account_id, target_ref, created_at]) // "what happened to this record" / "who accessed this player"
}
